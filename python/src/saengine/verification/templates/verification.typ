//
// Lays out the data of saengine.verification.run.manual_data, passed as JSON in
// sys.inputs.data. Values arrive as display strings (flags as booleans) and are printed as text.

#let data = json(bytes(sys.inputs.at("data")))
#let meta = data.meta

#let ink = luma(20)
#let muted = luma(95)
#let rule = luma(175)
#let head-fill = luma(232)
#let fail-fill = rgb("#f9d9d6")
#let fail-ink = rgb("#a1150c")
#let pass-ink = rgb("#1d6b2f")
#let note-fill = rgb("#eef2f7")

#set document(title: "SAEngine " + meta.title, author: "SAEngine")
#set text(font: ("Libertinus Serif", "New Computer Modern"), size: 10pt, fill: ink, lang: "en")
#set par(justify: true, leading: 0.62em)
#show heading.where(level: 1): it => {
  pagebreak(weak: true)
  set text(size: 15pt, weight: "bold")
  block(above: 0pt, below: 1em, it)
}
#show heading.where(level: 2): it => {
  set text(size: 11pt, weight: "bold")
  block(above: 1.3em, below: 0.6em, it)
}

#set page(
  paper: "a4",
  margin: (left: 20mm, right: 18mm, top: 24mm, bottom: 22mm),
  header: context {
    if counter(page).get().first() > 1 {
      set text(size: 8pt, fill: muted)
      grid(columns: (1fr, auto), "SAEngine " + meta.version, meta.title)
      v(-0.4em)
      line(length: 100%, stroke: 0.4pt + rule)
    }
  },
  footer: context {
    if counter(page).get().first() > 1 {
      set text(size: 8pt, fill: muted)
      line(length: 100%, stroke: 0.4pt + rule)
      v(-0.4em)
      grid(
        columns: (1fr, auto),
        [SAEngine #meta.version, #meta.isoDate], counter(page).display("1 / 1", both: true),
      )
    }
  },
)

// ───────────────────────────── helpers ─────────────────────────────

#let verdict(ok) = if ok {
  text(weight: "bold", fill: pass-ink, "pass")
} else {
  text(weight: "bold", fill: fail-ink, "FAIL")
}

#let grid-table(head, rows, columns: auto, align: none, bad: none, size: 8.5pt) = {
  let n = head.len()
  let aligns = if align == none { (left,) * n } else { align }
  set text(size: size)
  set par(justify: false)
  table(
    columns: if columns == auto { n } else { columns },
    align: (x, y) => aligns.at(x) + horizon,
    inset: (x: 4pt, y: 3.2pt),
    stroke: (x, y) => (
      top: if y == 0 { 0.8pt + ink } else { none },
      bottom: if y == 0 { 0.6pt + ink } else { 0.3pt + rule },
    ),
    fill: (x, y) => {
      if y == 0 { head-fill } else if bad != none and bad.at(y - 1, default: false) { fail-fill }
    },
    table.header(..head.map(h => text(weight: "bold", h))),
    ..rows.flatten(),
  )
}

#let pairs(rows) = {
  set text(size: 9pt)
  set par(justify: false)
  table(
    columns: (38mm, 1fr),
    inset: (x: 4pt, y: 3pt),
    stroke: (x, y) => (bottom: 0.3pt + rule),
    ..rows.map(((label, value)) => (text(fill: muted, label), value)).flatten(),
  )
}

#let boxed(body) = block(
  width: 100%,
  inset: (x: 8pt, y: 6pt),
  fill: note-fill,
  radius: 2pt,
  text(size: 9pt, body),
)

// ───────────────────────────── cover ─────────────────────────────

#page(header: none, footer: none, margin: (x: 25mm, top: 40mm, bottom: 25mm))[
  #set par(justify: false)
  #text(size: 10pt, fill: muted, tracking: 0.08em, upper("SAEngine"))
  #v(6mm)
  #text(size: 26pt, weight: "bold", meta.title)
  #v(4mm)
  #line(length: 100%, stroke: 1pt + ink)
  #v(8mm)
  #{
    set text(size: 10.5pt)
    table(
      columns: (45mm, 1fr),
      stroke: none,
      inset: (x: 0pt, y: 4pt),
      text(fill: muted, "SAEngine version"), meta.version,
      text(fill: muted, "Date"), meta.date,
      text(fill: muted, "Platform"), meta.platform,
      ..meta.versions.slice(1).map(((label, value)) => (text(fill: muted, label), value)).flatten(),
      text(fill: muted, "Result"),
      [#data.summary.passed of #data.summary.cases cases pass#if data.summary.failed != "0" [,
        #text(fill: fail-ink, weight: "bold")[#data.summary.failed fail]]],
    )
  }
  #v(1fr)
  #set text(size: 9pt, fill: muted)
  Each benchmark runs a small model through SAEngine's own pipeline (structural model, derived
  analysis model, OpenSees, SAEngine's result readers) or calls its design functions, and
  compares the outcome with an independent reference: a closed-form solution, a published
  benchmark or a hand calculation written out step by step. A quantity passes when SAEngine's
  value is within the stated relative tolerance of the reference.
  #v(3mm)
  Generated by `python -m saengine.verification --pdf`; typeset with Typst. SAEngine is free
  software under the AGPL-3.0.
]

#counter(page).update(2)

// ───────────────────────────── summary ─────────────────────────────

= Summary

#grid-table(
  ("Case", "Title", "Category", "Quantities", "Worst ratio", "Time [s]", "Result"),
  data.cases.map(c => (
    c.id,
    c.title,
    c.category,
    str(c.quantities.len()),
    c.worst,
    c.seconds,
    verdict(c.pass),
  )),
  columns: (auto, 1fr, auto, auto, auto, auto, auto),
  align: (left, left, left, right, right, right, center),
  bad: data.cases.map(c => not c.pass),
)

== All compared quantities

#grid-table(
  ("Case", "Quantity", "Unit", "Reference", "SAEngine", "Ratio", "Tolerance", "Result"),
  data.cases
    .map(c => c.quantities.map(q => (
      c.id, q.name, q.unit, q.reference, q.saengine, q.ratio, q.tolerance, verdict(q.pass),
    )))
    .flatten()
    .chunks(8),
  columns: (auto, 1fr, auto, auto, auto, auto, auto, auto),
  align: (left, left, left, right, right, right, right, center),
  bad: data.cases.map(c => c.quantities.map(q => not q.pass)).flatten(),
  size: 8pt,
)

Ratio = SAEngine / reference. Units: kN, kN·m, kN·m/m, kPa, MPa and mm unless stated.

// ───────────────────────────── cases ─────────────────────────────

#for c in data.cases [
  = #c.id #h(0.4em) #c.title

  #pairs((
    ("Category", c.category),
    ("Result", verdict(c.pass)),
    ("Run time", c.seconds + " s"),
  ))

  == Description
  #c.description

  == Model
  #c.model

  == Reference
  #pairs((
    ("Source", c.reference.source),
    ("Formulas", c.reference.formula),
  ))
  #if c.reference.steps.len() > 0 {
    set text(size: 9pt)
    set par(justify: false)
    enum(..c.reference.steps)
  }

  == Results
  #if c.error != "" {
    boxed[*The case could not be run:* #c.error]
  } else {
    grid-table(
      ("Quantity", "Unit", "Reference", "SAEngine", "Ratio", "Tolerance", "Result"),
      c.quantities.map(q => (
        q.name, q.unit, q.reference, q.saengine, q.ratio, q.tolerance, verdict(q.pass),
      )),
      columns: (1fr, auto, auto, auto, auto, auto, auto),
      align: (left, left, right, right, right, right, center),
      bad: c.quantities.map(q => not q.pass),
    )
  }

  #if c.notes.len() > 0 {
    v(0.6em)
    boxed[
      *Notes.*
      #for n in c.notes [#n #parbreak()]
    ]
  }
]
