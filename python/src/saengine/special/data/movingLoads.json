      "axles": [
        {"load": 35.0, "spacing": 0.0},
        {"load": 145.0, "spacing": 4.3},
        {"load": 145.0, "spacing": 4.3, "spacingMax": 9.0}
      ],
      "gauge": 1.8
    },
    "designTruckFixed": {
      "label": "HL-93 design truck, rear spacing 4.3 m (two trucks)",
      "axles": [
        {"load": 35.0, "spacing": 0.0},
        {"load": 145.0, "spacing": 4.3},
        {"load": 145.0, "spacing": 4.3}
      ],
      "gauge": 1.8
    },
    "designTandem": {
      "label": "HL-93 design tandem (2 × 110 kN at 1.2 m)",
      "axles": [
        {"load": 110.0, "spacing": 0.0},
        {"load": 110.0, "spacing": 1.2}
      ],
      "gauge": 1.8
    }
  },
  "loadModels": {
    "truckLane": {
      "label": "Design truck + lane load",
      "lanes": [{"vehicle": "designTruck", "lineLoad": 9.3, "dynamic": true}]
    },
    "tandemLane": {
      "label": "Design tandem + lane load",
      "lanes": [{"vehicle": "designTandem", "lineLoad": 9.3, "dynamic": true}]
    },
    "dualTruck": {
      "label": "90 % of two design trucks (15 m apart) + 90 % of the lane load",
      "lanes": [
        {
          "vehicle": "designTruckFixed",
          "vehicleFactor": 0.9,
          "secondGap": 15.0,
          "lineLoad": 9.3,
          "lineFactor": 0.9,
          "dynamic": true
        }
      ],
      "only": "hogging"
    }
  },
  "multiplePresence": [1.2, 1.0, 0.85, 0.65],
  "dynamic": {"method": "constant", "constant": 0.33},
  "clauses": {
    "code": "SAEngine practice (HL-93 basis)",
    "lanes": "after AASHTO LRFD Art. 3.6.1.1.1",
