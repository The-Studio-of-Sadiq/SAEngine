    },
    "eigenmode": {
      "$ref": "#/$defs/EigenmodeImperfection"
    },
    "plates": {
      "$ref": "#/$defs/PlateImperfection"
    },
    "yieldFactor": {
      "default": 1.0,
      "description": "The model's yield strength = this × fy (1/γM1, or 0.9 ...).",
      "exclusiveMinimum": 0,
      "title": "Yieldfactor",
      "type": "number"
    },
    "stiffnessFactor": {
      "default": 1.0,
      "description": "The model's modulus = this × E.",
      "exclusiveMinimum": 0,
      "title": "Stiffnessfactor",
      "type": "number"
    },
    "hardeningRatio": {
      "default": 0.0001,
      "description": "Strain hardening modulus / E of the steel.",
      "exclusiveMaximum": 1,
      "minimum": 0,
      "title": "Hardeningratio",
      "type": "number"
    },
    "requiredFactor": {
      "default": 1.0,
      "description": "The limit load factor of the combination needs at least this.",
      "exclusiveMinimum": 0,
      "title": "Requiredfactor",
      "type": "number"
    },
    "path": {
      "$ref": "#/$defs/StabilityPath"
    },
    "cables": {
      "$ref": "#/$defs/CableResistance"
    },
    "note": {
      "default": "",
      "title": "Note",
      "type": "string"
    }
  },
  "required": [
    "bow",
    "sway",
    "eigenmode",
    "plates",
    "cables"
  ],
  "title": "NonlinearStabilityTable",
  "type": "object",
  "$id": "saengine.codePack.nonlinearStability/1"
