          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Clause (and page) of this row.",
          "title": "Source"
        },
        "name": {
          "description": "The town as the code spells it.",
          "title": "Name",
          "type": "string"
        },
        "latitude": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitude",
          "type": "number"
        },
        "z": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Seismic zone coefficient Z; empty: not in the table.",
          "title": "Z"
        },
        "windSpeed": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Basic wind speed V [m/s]; empty: not in the table.",
          "title": "Windspeed"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Its ``locations`` id (Project Settings), where there is one.",
          "title": "Location"
        }
      },
      "required": [
        "name",
        "latitude",
        "longitude"
      ],
      "title": "Town",
      "type": "object"
    },
    "TownMap": {
      "additionalProperties": false,
