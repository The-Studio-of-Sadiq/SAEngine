      "properties": {
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Clause (and page) of this row.",
          "title": "Source"
        },
        "area": {
          "description": "Where the code applies (for the outside-the-area note).",
          "title": "Area",
          "type": "string"
        },
        "bounds": {
          "description": "(south, west, north, east) [degrees] of the area.",
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bounds",
          "type": "array"
        },
        "zClause": {
          "description": "The table of the towns' Z.",
          "title": "Zclause",
          "type": "string"
        },
        "windClause": {
          "description": "The table of the towns' V.",
          "title": "Windclause",
          "type": "string"
        },
        "governs": {
          "default": "",
          "description": "What governs over the nearest town.",
          "title": "Governs",
          "type": "string"
        },
        "towns": {
          "items": {
            "$ref": "#/$defs/Town"
          },
          "minItems": 1,
          "title": "Towns",
          "type": "array"
        }
