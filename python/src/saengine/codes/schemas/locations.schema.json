  "additionalProperties": false,
  "description": "Towns with their seismic zone and basic wind speed.",
  "properties": {
    "source": {
      "default": "",
      "description": "Clause (and page) the table comes from.",
      "title": "Source",
      "type": "string"
    },
    "sources": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Clause references of single entries: {key: clause}.",
      "title": "Sources",
      "type": "object"
    },
    "clauses": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Short clause references the results cite, by key, without the code's name (e.g. 'Part 6 Sec 2.5.7.3'); read by saengine.codes.context.cite. A key the pack does not give is not cited.",
      "title": "Clauses",
      "type": "object"
    },
    "locations": {
      "additionalProperties": {
        "$ref": "#/$defs/Location"
      },
      "title": "Locations",
      "type": "object"
    },
    "towns": {
      "anyOf": [
        {
          "$ref": "#/$defs/TownMap"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Towns with coordinates for the site map's suggestion; empty: the pack does not cover the suggestion."
    }
  },
  "required": [
    "locations"
  ],
  "title": "LocationsTable",
  "type": "object",
  "$id": "saengine.codePack.locations/1"
}
