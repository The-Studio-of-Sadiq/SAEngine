          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Betabottleplain",
          "type": "number"
        },
        "minAngle": {
          "default": 25.0,
          "description": "Least angle between a strut and a tie [degrees].",
          "exclusiveMaximum": 90,
          "exclusiveMinimum": 0,
          "title": "Minangle",
          "type": "number"
        },
        "webRatio": {
          "default": 0.003,
          "description": "Distributed web steel ratio that confines a bottle-shaped strut.",
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Webratio",
          "type": "number"
        }
      },
      "required": [
        "tieArm",
        "betaCCC",
        "betaCCT"
      ],
      "title": "StrutAndTie",
      "type": "object"
    },
    "SubgradeRow": {
      "additionalProperties": false,
      "description": "A band of the indicative modulus of subgrade reaction (300 mm plate): granular soil by\nSPT N, cohesive soil by the unconfined compressive strength qu [kPa]; ``k`` the range\n[kN/m³] over the band (dry or moist), ``submerged`` below the water table.",
      "properties": {
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Clause (and page) of this row.",
          "title": "Source"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "low": {
          "minimum": 0,
          "title": "Low",
          "type": "number"
        },
        "high": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Empty: open-ended.",
          "title": "High"
        },
        "k": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "K",
          "type": "array"
        },
        "submerged": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Submerged"
        }
      },
      "required": [
        "id",
        "name",
        "low",
        "k"
      ],
      "title": "SubgradeRow",
      "type": "object"
    }
