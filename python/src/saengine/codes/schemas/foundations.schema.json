        "betaCCT": {
          "description": "βn of a C-C-T node.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Betacct",
          "type": "number"
        },
        "betaCTT": {
          "default": 0.6,
          "description": "βn of a C-T-T node.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Betactt",
          "type": "number"
        },
        "betaPrism": {
          "default": 1.0,
          "description": "βs of a prism-shaped strut.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Betaprism",
          "type": "number"
        },
        "betaBottle": {
          "default": 0.75,
          "description": "βs of a bottle-shaped strut with distributed web steel.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Betabottle",
          "type": "number"
