    "AluminiumJoints": {
      "additionalProperties": false,
      "description": "Alpha 9 L7: bolted and welded joints of aluminium members (EN 1999 type): bolts in\nshear and bearing, fillet welds by their throat with the filler's fw, and the heat-affected\nzone beside the weld at fu,haz.",
      "properties": {
        "gammaM2": {
          "description": "γM2 of bolts and the members' bearing.",
          "exclusiveMinimum": 0,
          "title": "Gammam2",
          "type": "number"
        },
        "gammaMw": {
          "description": "γMw of welds and the heat-affected zone.",
          "exclusiveMinimum": 0,
          "title": "Gammamw",
          "type": "number"
        },
        "bolts": {
          "additionalProperties": {
            "$ref": "#/$defs/AluminiumBolt"
          },
          "minProperties": 1,
          "title": "Bolts",
          "type": "object"
        },
        "bearingK1Max": {
          "description": "k1 = min(2.8 e2/d0 - 1.7, this).",
          "exclusiveMinimum": 0,
          "title": "Bearingk1Max",
          "type": "number"
        },
        "holeClearance": {
          "description": "d0 = d + this [mm].",
          "minimum": 0,
          "title": "Holeclearance",
          "type": "number"
        },
        "weldStrength": {
          "additionalProperties": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "description": "fw [MPa] of the weld metal by '<alloy key>|<filler>' or '<filler>'.",
          "title": "Weldstrength",
          "type": "object"
        },
        "weldCriterion": {
          "default": 3.0,
          "description": "Fillet welds: √(σ⊥² + this (τ⊥² + τ∥²)) ≤ fw / γMw.",
          "exclusiveMinimum": 0,
          "title": "Weldcriterion",
          "type": "number"
        }
      },
      "required": [
        "gammaM2",
        "gammaMw",
        "bolts",
        "bearingK1Max",
        "holeClearance",
        "weldStrength"
      ],
      "title": "AluminiumJoints",
      "type": "object"
    },
