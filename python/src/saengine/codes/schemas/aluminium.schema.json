{
  "$defs": {
    "AluminiumAlloy": {
      "additionalProperties": false,
      "description": "One alloy and temper: f0, fu by product and thickness, the heat-affected zone and the\nbuckling class.",
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "f0": {
          "description": "0.2 % proof strength [MPa].",
          "exclusiveMinimum": 0,
          "title": "F0",
          "type": "number"
        },
        "fu": {
          "description": "Ultimate tensile strength [MPa].",
          "exclusiveMinimum": 0,
          "title": "Fu",
          "type": "number"
        },
        "thicknessMax": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Up to this thickness [mm].",
          "title": "Thicknessmax"
        },
        "rhoHazProof": {
          "description": "ρo,haz = fo,haz / fo.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Rhohazproof",
          "type": "number"
        },
        "rhoHazUltimate": {
          "description": "ρu,haz = fu,haz / fu.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Rhohazultimate",
          "type": "number"
        },
        "bucklingClass": {
          "enum": [
            "A",
            "B"
          ],
          "title": "Bucklingclass",
          "type": "string"
        }
      },
      "required": [
        "label",
        "f0",
        "fu",
        "rhoHazProof",
        "rhoHazUltimate",
        "bucklingClass"
      ],
      "title": "AluminiumAlloy",
      "type": "object"
    },
    "AluminiumBolt": {
      "additionalProperties": false,
      "description": "A bolt material of aluminium joints: fub and αv of its shear resistance.",
      "properties": {
        "fub": {
          "description": "Ultimate strength of the bolt [MPa].",
          "exclusiveMinimum": 0,
          "title": "Fub",
          "type": "number"
        },
        "alphaV": {
          "description": "Fv,Rd = αv fub A / γM2 (A the stress area).",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Alphav",
          "type": "number"
        },
        "stressArea": {
          "default": 0.78,
          "description": "The threaded part's stress area As = this × π d² / 4.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Stressarea",
          "type": "number"
        }
      },
      "required": [
        "fub",
        "alphaV"
      ],
      "title": "AluminiumBolt",
      "type": "object"
    },
