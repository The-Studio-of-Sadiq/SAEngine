      "type": "object"
    },
    "CompositeCamber": {
      "additionalProperties": false,
      "description": "The camber proposed for an unshored composite beam: ``share`` × the deflection of the\nsteel alone under the wet concrete, the deck and the beam (5 w L⁴ / 384 E Is), rounded down\nto ``step``; none below ``minimum``. Reported, not checked.",
      "properties": {
        "share": {
          "description": "Of the wet-concrete deflection.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Share",
          "type": "number"
        },
        "minimum": {
          "description": "No camber below this [mm].",
          "exclusiveMinimum": 0,
          "title": "Minimum",
          "type": "number"
        },
        "step": {
          "description": "Rounded down to this [mm].",
          "exclusiveMinimum": 0,
          "title": "Step",
          "type": "number"
        }
      },
      "required": [
        "share",
        "minimum",
        "step"
      ],
      "title": "CompositeCamber",
      "type": "object"
    },
    "CompositeChannel": {
      "additionalProperties": false,
      "properties": {
        "coefficient": {
