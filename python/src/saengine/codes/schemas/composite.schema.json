{
  "$defs": {
    "CompositeBeamLimitState": {
      "additionalProperties": false,
      "description": "C9: the plastic positive moment of composite beams with design strengths (method\n``partialFactors``): the concrete at ``concreteShare`` × the grade over the block depth,\nthe steel at fy / ``steelGamma``, no φ; headed studs by their tabulated design strength\n(``studs``: rows by size, columns by ``grades``, linear between the grades; a stud takes\nthe largest row not larger than it) × ``studShare``.",
      "properties": {
        "method": {
          "const": "partialFactors",
          "default": "partialFactors",
          "title": "Method",
          "type": "string"
        },
        "concreteShare": {
          "description": "Design concrete stress of the block / the grade.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Concreteshare",
          "type": "number"
        },
        "steelGamma": {
          "description": "γ of the steel beam's yield stress.",
          "exclusiveMinimum": 0,
          "title": "Steelgamma",
          "type": "number"
        },
        "grades": {
          "description": "Concrete grade [MPa].",
          "items": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "minItems": 2,
          "title": "Grades",
          "type": "array"
        },
        "studs": {
          "items": {
            "$ref": "#/$defs/CompositeStudRow"
          },
          "minItems": 1,
          "title": "Studs",
          "type": "array"
        },
        "studShare": {
          "description": "× the tabulated strength.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Studshare",
          "type": "number"
        }
      },
      "required": [
        "concreteShare",
        "steelGamma",
        "grades",
        "studs",
        "studShare"
      ],
      "title": "CompositeBeamLimitState",
      "type": "object"
    },
    "CompositeBeamRules": {
      "additionalProperties": false,
      "properties": {
        "spanShare": {
          "description": "Effective width per side at most this × span.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Spanshare",
          "type": "number"
        },
        "spacingShare": {
          "description": "... and this × the distance to the next beam.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Spacingshare",
          "type": "number"
        },
        "webCompact": {
          "description": "Plastic when h/tw ≤ this × √(E/Fy).",
          "exclusiveMinimum": 0,
          "title": "Webcompact",
          "type": "number"
        },
        "constructionStrength": {
          "description": "Steel alone until f'c reaches this share.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Constructionstrength",
          "type": "number"
        },
        "constructionDeadFactor": {
          "exclusiveMinimum": 0,
          "title": "Constructiondeadfactor",
          "type": "number"
        },
        "constructionLiveFactor": {
          "exclusiveMinimum": 0,
          "title": "Constructionlivefactor",
          "type": "number"
        },
        "deck": {
          "$ref": "#/$defs/CompositeDeck"
        },
        "studs": {
          "$ref": "#/$defs/CompositeStuds"
        },
        "channel": {
          "$ref": "#/$defs/CompositeChannel"
        },
        "spacing": {
          "$ref": "#/$defs/CompositeSpacing"
        },
        "deflection": {
          "$ref": "#/$defs/CompositeDeflection"
        },
        "slab": {
          "$ref": "#/$defs/CompositeSlab"
        },
        "limitState": {
          "anyOf": [
            {
              "$ref": "#/$defs/CompositeBeamLimitState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "longitudinalShear": {
          "anyOf": [
            {
              "$ref": "#/$defs/CompositeLongitudinalShear"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "camber": {
          "anyOf": [
            {
              "$ref": "#/$defs/CompositeCamber"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "spanShare",
        "spacingShare",
        "webCompact",
        "constructionStrength",
        "constructionDeadFactor",
        "constructionLiveFactor",
        "deck",
        "studs",
        "channel",
        "spacing",
        "deflection",
        "slab"
      ],
      "title": "CompositeBeamRules",
      "type": "object"
    },
    "CompositeBuckling": {
      "additionalProperties": false,
      "properties": {
        "ratio": {
          "description": "Inelastic buckling when Pe ≥ this × Po.",
          "exclusiveMinimum": 0,
          "title": "Ratio",
          "type": "number"
        },
        "base": {
          "description": "Pn = Po × this^(Po/Pe).",
          "exclusiveMinimum": 0,
          "title": "Base",
          "type": "number"
        },
