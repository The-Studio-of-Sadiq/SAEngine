{
  "$defs": {
    "Basis": {
      "additionalProperties": false,
      "description": "What the report and the design method state the design follows. A pack that extends\nanother inherits the labels it does not give; without any, the pack's edition (or name).",
      "properties": {
        "general": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Loads and general, e.g. 'BNBC 2020'.",
          "title": "General"
        },
        "concrete": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Concrete design, e.g. 'BNBC 2020 Part 6 Chapter 6'.",
          "title": "Concrete"
        },
        "steel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Steel design, e.g. 'BNBC 2020 Part 6 Chapter 10'.",
          "title": "Steel"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Design method, e.g. 'Strength design (LRFD)'.",
          "title": "Method"
        }
      },
      "title": "Basis",
      "type": "object"
    },
    "Requires": {
      "additionalProperties": false,
      "description": "What a package needs: the SAEngine versions that understand it and other packages.",
      "properties": {
        "saengine": {
          "anyOf": [
            {
              "pattern": "^\\s*(?:>=|<=|==|!=|~=|>|<)?\\s*\\d+(?:\\.\\d+)*(?:\\s*,\\s*(?:>=|<=|==|!=|~=|>|<)?\\s*\\d+(?:\\.\\d+)*)*\\s*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SAEngine versions the package works with, e.g. '>=0.0.50'.",
          "title": "Saengine"
        },
        "packages": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Other packages it needs, by id, with their versions, e.g. {'bnbc2020': '>=1.0.0'} for a building template made with BNBC 2020.",
          "title": "Packages",
          "type": "object"
        }
      },
      "title": "Requires",
      "type": "object"
    },
    "Source": {
      "additionalProperties": true,
      "description": "A document the pack's values come from (a code, a standard, a gazette notification).",
      "properties": {
        "id": {
          "description": "Short reference used in the tables' clause refs, e.g. 'BNBC'.",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "edition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Edition"
        },
        "publisher": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publisher"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``pack.json``: what the pack is, which pack it builds on and which tables it provides.",
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Path of the JSON Schema, for editors.",
      "title": "$Schema"
    },
    "$comment": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "$Comment"
    },
    "schema": {
      "const": "saengine.codePack/1",
      "default": "saengine.codePack/1",
      "title": "Schema",
      "type": "string"
    },
    "kind": {
      "default": "designCode",
      "description": "What the package holds: a design code (default), a structure template (presets of a parametric shape), a building template or a language pack.",
      "enum": [
        "designCode",
        "structureTemplate",
        "buildingTemplate",
        "languagePack"
      ],
      "title": "Kind",
      "type": "string"
    },
    "language": {
      "anyOf": [
        {
          "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Language pack: the language it translates to (BCP 47, e.g. 'bn').",
      "title": "Language"
    },
    "id": {
      "description": "Unique id: lower case letters, digits, '.', '_' and '-', e.g. 'bnbc2020'.",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "description": "Readable name, e.g. 'BNBC 2020'.",
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "edition": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Edition or year of the code.",
      "title": "Edition"
    },
    "country": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "ISO 3166 country code, e.g. 'BD'.",
      "title": "Country"
    },
    "region": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "State, province or city, when local.",
      "title": "Region"
    },
    "version": {
      "default": "1.0.0",
      "description": "Version of the pack itself.",
      "title": "Version",
      "type": "string"
    },
    "extends": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Id of the pack this one builds on; tables not provided here are inherited.",
      "title": "Extends"
    },
    "covers": {
      "description": "The areas (table names) this pack provides, e.g. ['locations', 'wind'].",
      "items": {
        "type": "string"
      },
      "title": "Covers",
      "type": "array"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "sources": {
      "description": "The documents the values come from.",
      "items": {
        "$ref": "#/$defs/Source"
      },
      "title": "Sources",
      "type": "array"
    },
    "clauses": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "description": "Clause references per table, e.g. {'combinations': ['BNBC Part 6 2.7.3']}; a data file's own '$sources' take precedence.",
      "title": "Clauses",
      "type": "object"
    },
    "basis": {
      "anyOf": [
        {
          "$ref": "#/$defs/Basis"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The code the design follows, as the report states it (loads and general, concrete, steel, design method)."
    },
    "author": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Author"
    },
    "licence": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "SPDX id of the pack's licence.",
      "title": "Licence"
    },
    "hooks": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Python file in the pack (e.g. 'hooks.py') whose top-level functions override design functions of the same name. Imported only when the user trusts the pack; editing the file revokes the trust.",
      "title": "Hooks"
    },
    "requires": {
      "anyOf": [
        {
          "$ref": "#/$defs/Requires"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The SAEngine versions and the other packages it needs."
    },
    "contents": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The package's files of its kind, as paths or globs relative to its folder (default: 'data/*.json' for a design code, 'templates/*.json' for a structure template, 'spec.json' and 'template.civil' for a building template).",
      "title": "Contents"
    },
    "preview": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Card image of the package: a small .png, .jpg or .webp in its folder.",
      "title": "Preview"
    }
  },
  "required": [
    "id",
    "name"
  ],
  "title": "SAEngine package (code pack)",
  "type": "object",
  "$id": "saengine.codePack/1"
}
