{
  "$defs": {
    "BarBends": {
      "additionalProperties": false,
      "description": "Least inside bend diameters, as a multiple of db.",
      "properties": {
        "steps": {
          "description": "(db up to [mm], factor) in ascending db; bars above the last: its factor.",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "exclusiveMinimum": 0,
                "type": "number"
              },
              {
                "exclusiveMinimum": 0,
                "type": "number"
              }
            ],
            "type": "array"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "transverseMax": {
          "description": "Stirrups and ties up to this db [mm] ...",
          "exclusiveMinimum": 0,
          "title": "Transversemax",
          "type": "number"
        },
        "transverse": {
          "description": "... bend at this × db.",
          "exclusiveMinimum": 0,
          "title": "Transverse",
          "type": "number"
        }
      },
      "required": [
        "steps",
        "transverseMax",
        "transverse"
      ],
      "title": "BarBends",
      "type": "object"
    },
    "BarDetailing": {
      "additionalProperties": false,
      "description": "The bar detailing rules of the drawings: hooks, bends, development, laps, splice zones and\nbar extents.",
      "properties": {
        "hooks": {
          "$ref": "#/$defs/BarHooks"
        },
        "bends": {
          "$ref": "#/$defs/BarBends"
        },
        "development": {
          "$ref": "#/$defs/BarDevelopment"
        },
        "laps": {
          "$ref": "#/$defs/BarLaps"
        },
        "splices": {
          "$ref": "#/$defs/BarSplices"
        },
        "extents": {
          "$ref": "#/$defs/BarExtents"
        },
        "notes": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Short notes the formulas print, by key: 'ldMin', 'excess' (the sub-clause after the term), 'simplifiedOther' (said of small bars in other cases); none: nothing.",
          "title": "Notes",
          "type": "object"
        }
      },
      "required": [
        "hooks",
        "bends",
        "development",
        "laps",
        "splices",
        "extents"
      ],
      "title": "BarDetailing",
      "type": "object"
    },
    "BarDevelopment": {
      "additionalProperties": false,
      "description": "Development lengths of deformed bars (straight in tension and compression, hooked).",
      "properties": {
        "sqrtFcMax": {
          "description": "√f'c used at most [MPa].",
          "exclusiveMinimum": 0,
          "title": "Sqrtfcmax",
          "type": "number"
        },
        "ldMin": {
          "description": "ld in tension at least [mm].",
          "exclusiveMinimum": 0,
          "title": "Ldmin",
          "type": "number"
        },
        "ldcMin": {
          "description": "ldc in compression at least [mm].",
          "exclusiveMinimum": 0,
          "title": "Ldcmin",
          "type": "number"
        },
        "smallBarMax": {
          "description": "'Small' bars up to this db [mm] (k, ψs).",
          "exclusiveMinimum": 0,
          "title": "Smallbarmax",
          "type": "number"
        },
        "simplifiedGood": {
          "description": "Simplified form, spacing and cover met: k of (small, larger) bars.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          ],
          "title": "Simplifiedgood",
          "type": "array"
        },
        "simplifiedOther": {
          "description": "Simplified form, other cases: k of (small, larger) bars.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          ],
          "title": "Simplifiedother",
          "type": "array"
        },
        "general": {
          "description": "General form: the k of the denominator.",
          "exclusiveMinimum": 0,
          "title": "General",
          "type": "number"
        },
        "confinementMax": {
          "description": "(cb + Ktr)/db at most.",
          "exclusiveMinimum": 0,
          "title": "Confinementmax",
          "type": "number"
        },
        "ktr": {
          "description": "Ktr = this × Atr / (s n).",
          "exclusiveMinimum": 0,
          "title": "Ktr",
          "type": "number"
        },
        "psiTop": {
          "description": "ψt of top bars.",
          "minimum": 1,
          "title": "Psitop",
          "type": "number"
        },
        "psiTEMax": {
          "description": "ψt ψe at most.",
          "exclusiveMinimum": 0,
          "title": "Psitemax",
          "type": "number"
        },
        "psiSSmall": {
          "description": "ψs of small bars (1.0 for larger).",
          "exclusiveMinimum": 0,
          "title": "Psissmall",
          "type": "number"
        },
        "compression": {
          "description": "ldc = max(a fy db / (λ √f'c), b fy db).",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          ],
          "title": "Compression",
          "type": "array"
        },
        "compressionConfined": {
          "description": "ldc × this inside spirals or close ties.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Compressionconfined",
          "type": "number"
        },
        "hookCover": {
          "description": "ldh × this with the side and tail cover.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Hookcover",
          "type": "number"
        },
        "hookConfined": {
          "description": "ldh × this inside close ties.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Hookconfined",
          "type": "number"
        },
        "hookMethod": {
          "default": "linear",
          "description": "ldh: 'linear' (0.24 ψe fy db / (λ √f'c) × hookCover, hookConfined) or 'powerDiameter' (fy ψe ψr ψo ψc db^exponent / (coefficient λ √f'c), ``hook``).",
          "enum": [
            "linear",
            "powerDiameter"
          ],
          "title": "Hookmethod",
          "type": "string"
        },
        "hook": {
          "anyOf": [
            {
              "$ref": "#/$defs/HookDevelopment"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The values of hookMethod 'powerDiameter'."
        },
        "headed": {
          "anyOf": [
            {
              "$ref": "#/$defs/HeadedDevelopment"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ldt of headed bars in tension (None: not covered)."
        },
        "psiG": {
          "anyOf": [
            {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "exclusiveMinimum": 0,
                    "type": "number"
                  },
                  {
                    "exclusiveMinimum": 0,
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Grade factor ψg of ld: (fy up to [MPa], ψg) ascending; above the last: its ψg. None: no grade factor (1.0).",
          "title": "Psig"
        }
      },
      "required": [
        "sqrtFcMax",
        "ldMin",
        "ldcMin",
        "smallBarMax",
        "simplifiedGood",
        "simplifiedOther",
        "general",
        "confinementMax",
        "ktr",
        "psiTop",
        "psiTEMax",
        "psiSSmall",
        "compression",
        "compressionConfined",
        "hookCover",
        "hookConfined"
      ],
      "title": "BarDevelopment",
      "type": "object"
    },
