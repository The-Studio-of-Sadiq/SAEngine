{
  "$defs": {
    "BarSpacing": {
      "additionalProperties": false,
      "description": "Least clear spacing of parallel bars (the 3D rebar cages' congestion check).",
      "properties": {
        "layerMin": {
          "description": "Bars in a layer: at least this clear [mm].",
          "exclusiveMinimum": 0,
          "title": "Layermin",
          "type": "number"
        },
        "layerDb": {
          "description": "Bars in a layer: at least this many db clear.",
          "exclusiveMinimum": 0,
          "title": "Layerdb",
          "type": "number"
        },
        "betweenLayers": {
          "description": "Between layers of bars, clear [mm].",
          "exclusiveMinimum": 0,
          "title": "Betweenlayers",
          "type": "number"
        },
        "columnMin": {
          "description": "Column bars: at least this clear [mm].",
          "exclusiveMinimum": 0,
          "title": "Columnmin",
          "type": "number"
        },
        "columnDb": {
          "description": "Column bars: at least this many db clear.",
          "exclusiveMinimum": 0,
          "title": "Columndb",
          "type": "number"
        }
      },
      "required": [
        "layerMin",
        "layerDb",
        "betweenLayers",
        "columnMin",
        "columnDb"
      ],
      "title": "BarSpacing",
      "type": "object"
    },
    "CrackControl": {
      "additionalProperties": false,
      "description": "Spacing of the bars nearest the tension face: s <= coefficient (reference / fs) -\ncoverFactor cc, and <= cap (reference / fs) [mm, MPa].",
      "properties": {
        "coefficient": {
          "exclusiveMinimum": 0,
          "title": "Coefficient",
          "type": "number"
        },
        "reference": {
          "description": "Reference stress [MPa].",
          "exclusiveMinimum": 0,
          "title": "Reference",
          "type": "number"
        },
        "coverFactor": {
          "minimum": 0,
          "title": "Coverfactor",
          "type": "number"
        },
        "cap": {
          "exclusiveMinimum": 0,
          "title": "Cap",
          "type": "number"
        },
        "serviceStressShare": {
          "description": "fs may be taken as this × fy.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Servicestressshare",
          "type": "number"
        }
      },
      "required": [
        "coefficient",
        "reference",
        "coverFactor",
        "cap",
        "serviceStressShare"
      ],
      "title": "CrackControl",
      "type": "object"
    },
    "FlangeTension": {
      "additionalProperties": false,
      "description": "Tension steel of T-beam flanges and the effective flange width.",
      "properties": {
        "spanShare": {
          "description": "Spread over at most this × span.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Spanshare",
          "type": "number"
        },
        "bothSidesSpan": {
          "description": "Slab both sides: bf <= this × span.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Bothsidesspan",
          "type": "number"
        },
        "bothSidesThickness": {
          "description": "... overhang <= this × hf each side.",
          "exclusiveMinimum": 0,
          "title": "Bothsidesthickness",
          "type": "number"
        },
        "oneSideSpan": {
          "description": "Slab one side: overhang <= this × span.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Onesidespan",
          "type": "number"
        },
        "oneSideThickness": {
          "description": "... and <= this × hf.",
          "exclusiveMinimum": 0,
          "title": "Onesidethickness",
          "type": "number"
        }
      },
      "required": [
        "spanShare",
        "bothSidesSpan",
        "bothSidesThickness",
        "oneSideSpan",
        "oneSideThickness"
      ],
      "title": "FlangeTension",
      "type": "object"
    },
    "Joints": {
      "additionalProperties": false,
      "description": "Plain numbers of special moment frame beam-column joints.",
      "properties": {
        "probableStress": {
          "description": "Probable stress factor of bars (1.25 fy).",
          "minimum": 1,
          "title": "Probablestress",
          "type": "number"
        },
        "strongColumnRatio": {
          "description": "ΣMnc/ΣMnb least.",
          "minimum": 1,
          "title": "Strongcolumnratio",
          "type": "number"
        },
        "axialLimit": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Axiallimit",
          "type": "number"
        },
        "gamma": {
          "additionalProperties": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "title": "Gamma",
          "type": "object"
        },
        "vcZeroAxial": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Vczeroaxial",
          "type": "number"
        }
      },
      "required": [
        "probableStress",
        "strongColumnRatio",
        "axialLimit",
        "gamma",
        "vcZeroAxial"
      ],
      "title": "Joints",
      "type": "object"
    },
    "LintelLimits": {
      "additionalProperties": false,
      "properties": {
        "minBearing": {
          "description": "[mm]",
          "exclusiveMinimum": 0,
          "title": "Minbearing",
          "type": "number"
        },
        "bearing": {
          "description": "[mm]",
          "exclusiveMinimum": 0,
          "title": "Bearing",
          "type": "number"
        },
        "deflectionRatio": {
          "description": "span / deflection limit",
          "exclusiveMinimum": 0,
          "title": "Deflectionratio",
          "type": "number"
        },
        "probable": {
          "minimum": 1,
          "title": "Probable",
          "type": "number"
        }
      },
      "required": [
        "minBearing",
        "bearing",
        "deflectionRatio",
        "probable"
      ],
      "title": "LintelLimits",
      "type": "object"
    },
    "ShearFriction": {
      "additionalProperties": false,
      "description": "Shear transfer across a plane: Vn = Avf fy μ (+ permanent compression), μ = factor λ.",
      "properties": {
        "mu": {
          "additionalProperties": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "description": "Surface -> μ / λ.",
          "minProperties": 1,
          "title": "Mu",
          "type": "object"
        },
        "roughLimits": {
          "description": "Monolithic or roughened normal weight: Vn <= min(a f'c, b + c f'c, d) Ac.",
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          ],
          "title": "Roughlimits",
          "type": "array"
        },
        "otherLimits": {
          "description": "Other cases: Vn <= min(a f'c, b) Ac.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          ],
          "title": "Otherlimits",
          "type": "array"
        },
        "roughSurfaces": {
          "description": "The surfaces the rough limits apply to.",
          "items": {
            "type": "string"
          },
          "title": "Roughsurfaces",
          "type": "array"
        },
        "fyMax": {
          "description": "fy of shear-friction steel at most [MPa].",
          "exclusiveMinimum": 0,
          "title": "Fymax",
          "type": "number"
        },
        "roughness": {
          "description": "Roughened to a full amplitude of about [mm].",
          "exclusiveMinimum": 0,
          "title": "Roughness",
          "type": "number"
        }
      },
      "required": [
        "mu",
        "roughLimits",
        "otherLimits",
        "roughSurfaces",
        "fyMax",
        "roughness"
      ],
      "title": "ShearFriction",
      "type": "object"
    },
    "SkinSteel": {
      "additionalProperties": false,
      "description": "Longitudinal skin steel on the side faces of deep beams.",
      "properties": {
        "depthOver": {
          "description": "Needed where h exceeds this [mm].",
          "exclusiveMinimum": 0,
          "title": "Depthover",
          "type": "number"
        },
        "extentShare": {
          "description": "Over this × h from the tension face.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Extentshare",
          "type": "number"
        }
      },
      "required": [
        "depthOver",
        "extentShare"
      ],
      "title": "SkinSteel",
      "type": "object"
    },
    "SpecialFrames": {
      "additionalProperties": false,
      "description": "Plain-number limits of special moment frame members.",
      "properties": {
        "axialShare": {
          "description": "Pu/(Ag·f'c) above which a member is a column.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Axialshare",
          "type": "number"
        },
        "beamRhoMax": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Beamrhomax",
          "type": "number"
        },
        "columnRho": {
          "description": "(least, largest) ρ of columns.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "exclusiveMaximum": 1,
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "exclusiveMaximum": 1,
              "exclusiveMinimum": 0,
              "type": "number"
            }
          ],
          "title": "Columnrho",
          "type": "array"
        },
        "beamMinWidth": {
          "description": "[mm]",
          "exclusiveMinimum": 0,
          "title": "Beamminwidth",
          "type": "number"
        },
        "beamMinRatio": {
          "description": "Least width/depth of beams.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Beamminratio",
          "type": "number"
        },
        "columnMinDimension": {
          "description": "[mm]",
          "exclusiveMinimum": 0,
          "title": "Columnmindimension",
          "type": "number"
        },
        "columnMinRatio": {
          "description": "Least short/long side of columns.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Columnminratio",
          "type": "number"
        },
        "fytConfinementMax": {
          "description": "Largest fyt of confinement [MPa].",
          "exclusiveMinimum": 0,
          "title": "Fytconfinementmax",
          "type": "number"
        },
        "hxMax": {
          "description": "Largest hx [mm].",
          "exclusiveMinimum": 0,
          "title": "Hxmax",
          "type": "number"
        },
        "unsupportedClear": {
          "description": "[mm]",
          "exclusiveMinimum": 0,
          "title": "Unsupportedclear",
          "type": "number"
        },
        "beamFirstHoop": {
          "description": "First hoop from the column face [mm].",
          "exclusiveMinimum": 0,
          "title": "Beamfirsthoop",
          "type": "number"
        }
      },
      "required": [
        "axialShare",
        "beamRhoMax",
        "columnRho",
        "beamMinWidth",
        "beamMinRatio",
        "columnMinDimension",
        "columnMinRatio",
        "fytConfinementMax",
        "hxMax",
        "unsupportedClear",
        "beamFirstHoop"
      ],
