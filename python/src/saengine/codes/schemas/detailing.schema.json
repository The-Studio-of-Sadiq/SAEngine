        "deltaMax": {
          "description": "Δfps at most [MPa].",
          "exclusiveMinimum": 0,
          "title": "Deltamax",
          "type": "number"
        },
        "deltaExempt": {
          "description": "Δfps up to this: (a) and (b) do not apply [MPa].",
          "exclusiveMinimum": 0,
          "title": "Deltaexempt",
          "type": "number"
        }
      },
      "required": [
        "share",
        "mixedShare",
        "deltaMax",
        "deltaExempt"
      ],
      "title": "TendonSpacing",
      "type": "object"
    }
