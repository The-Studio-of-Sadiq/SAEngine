      "additionalProperties": false,
      "description": "Continuous bars of cast-in-place beams.",
      "properties": {
        "perimeterTopShare": {
          "description": "Perimeter beams: top >= this × As- at supports.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Perimetertopshare",
          "type": "number"
        },
        "perimeterBottomShare": {
          "description": "... bottom >= this × As+ at midspan.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Perimeterbottomshare",
          "type": "number"
        },
        "otherBottomShare": {
          "description": "Other beams: bottom >= this × As+ at midspan.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Otherbottomshare",
          "type": "number"
