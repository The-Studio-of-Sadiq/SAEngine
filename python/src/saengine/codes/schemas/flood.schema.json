      "additionalProperties": false,
      "description": "Extreme surface water level yT above the datum at a coastal location.",
      "properties": {
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Clause (and page) of this row.",
          "title": "Source"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "thana": {
          "default": "",
          "title": "Thana",
          "type": "string"
        },
        "level50": {
          "description": "yT, 50-year [m above the datum].",
          "title": "Level50",
          "type": "number"
        },
        "level100": {
          "description": "yT, 100-year [m above the datum].",
          "title": "Level100",
          "type": "number"
        }
      },
      "required": [
        "name",
        "level50",
        "level100"
      ],
