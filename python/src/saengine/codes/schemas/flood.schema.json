  "additionalProperties": false,
  "description": "Flood and surge loads (hydrostatic, hydrodynamic, waves, impact), the stability of the\nbuilding against them, and the other miscellaneous loads: rain, helicopter landing areas,\nexplosions and air raid shelters.",
  "properties": {
    "source": {
      "default": "",
      "description": "Clause (and page) the table comes from.",
      "title": "Source",
      "type": "string"
    },
    "sources": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Clause references of single entries: {key: clause}.",
      "title": "Sources",
      "type": "object"
    },
    "returnPeriod": {
      "additionalProperties": {
        "type": "integer"
      },
      "description": "Return period [years] of the flood levels, surge heights and wind by occupancy category.",
      "title": "Returnperiod",
      "type": "object"
    },
    "waterLevelReturnPeriod": {
      "additionalProperties": {
        "type": "integer"
      },
      "description": "Column of the extreme surface water level table by occupancy category (empty: returnPeriod).",
      "title": "Waterlevelreturnperiod",
      "type": "object"
    },
    "waterUnitWeight": {
      "additionalProperties": {
        "exclusiveMinimum": 0,
        "type": "number"
      },
      "description": "Unit weight of water γw [kN/m³]: fresh, salt.",
      "title": "Waterunitweight",
      "type": "object"
    },
    "surgeRegions": {
      "additionalProperties": {
        "$ref": "#/$defs/SurgeRegion"
      },
      "title": "Surgeregions",
      "type": "object"
    },
    "minDistance": {
      "description": "Distance x [km] below which x is taken as this.",
      "exclusiveMinimum": 0,
      "title": "Mindistance",
      "type": "number"
    },
    "waterLevels": {
      "additionalProperties": {
        "$ref": "#/$defs/WaterLevelStation"
      },
      "title": "Waterlevels",
      "type": "object"
    },
    "freeWaterIncrease": {
      "description": "Added to Hm for surfaces exposed to free water [m].",
      "minimum": 0,
      "title": "Freewaterincrease",
      "type": "number"
    },
    "hydrodynamic": {
      "$ref": "#/$defs/FloodHydrodynamic"
    },
    "breakingWave": {
      "anyOf": [
        {
          "$ref": "#/$defs/BreakingWave"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "impact": {
      "anyOf": [
        {
          "$ref": "#/$defs/FloodImpact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "breakaway": {
      "anyOf": [
        {
          "$ref": "#/$defs/BreakawayWalls"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "stabilityFactor": {
      "description": "Least factor of safety against overturning and sliding under wind and flood together, dead load only.",
      "exclusiveMinimum": 0,
      "title": "Stabilityfactor",
      "type": "number"
    },
    "flotationFactor": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Least dead load / buoyancy of a dry floodproofed building.",
      "title": "Flotationfactor"
    },
    "rain": {
      "anyOf": [
        {
          "$ref": "#/$defs/RainRule"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "helipad": {
      "anyOf": [
        {
          "$ref": "#/$defs/HelipadRule"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "explosion": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExplosionRule"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "shelter": {
      "anyOf": [
        {
          "$ref": "#/$defs/ShelterRule"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "notes": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Labels of entries that are not the code's own text, or read with care.",
      "title": "Notes",
      "type": "object"
    }
  },
  "required": [
    "returnPeriod",
    "waterUnitWeight",
    "minDistance",
    "freeWaterIncrease",
    "hydrodynamic",
    "stabilityFactor"
