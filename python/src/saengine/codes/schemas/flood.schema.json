        "decay": {
          "description": "Rate of decrease k of the surge height inland [m/km].",
          "exclusiveMinimum": 0,
          "title": "Decay",
          "type": "number"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "name",
        "height50",
        "height100",
        "decay"
