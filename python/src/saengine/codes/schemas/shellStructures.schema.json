{
  "$defs": {
    "ChimneyRules": {
      "additionalProperties": false,
      "description": "Vortex shedding of circular chimneys: the critical speed vcrit = b n / St, the Scruton\nnumber Sc = 2 δs m / (ρ b²) and the largest cross-wind amplitude yF = b K Kw clat /\n(St² Sc) (the effective correlation length method).",
      "properties": {
        "method": {
          "const": "correlationLength",
          "default": "correlationLength",
          "title": "Method",
          "type": "string"
        },
        "strouhal": {
          "exclusiveMinimum": 0,
          "title": "Strouhal",
          "type": "number"
        },
        "modeFactor": {
          "description": "K of the first cantilever mode.",
          "exclusiveMinimum": 0,
          "title": "Modefactor",
          "type": "number"
        },
        "kwMax": {
          "description": "Kw at most.",
          "exclusiveMinimum": 0,
          "title": "Kwmax",
          "type": "number"
        },
        "lateral": {
          "description": "(Re, clat,0) points; log-linear in Re between.",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "exclusiveMinimum": 0,
                "type": "number"
              },
              {
                "exclusiveMinimum": 0,
                "type": "number"
              }
            ],
            "type": "array"
          },
          "minItems": 2,
          "title": "Lateral",
          "type": "array"
        },
        "correlation": {
          "description": "(Lj/b below yF/b 0.1, slope of 4.8 + this yF/b up to 0.6, Lj/b above).",
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          ],
          "title": "Correlation",
          "type": "array"
        },
        "damping": {
          "additionalProperties": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "description": "Structural logarithmic decrement δs by kind of chimney.",
          "minProperties": 1,
          "title": "Damping",
          "type": "object"
        },
        "speedMargin": {
          "description": "Vortex shedding needs checking where vcrit < this × the mean speed.",
          "exclusiveMinimum": 0,
          "title": "Speedmargin",
          "type": "number"
        },
        "airDensity": {
          "default": 1.25,
          "description": "[kg/m³].",
          "exclusiveMinimum": 0,
          "title": "Airdensity",
          "type": "number"
        },
        "kinematicViscosity": {
          "default": 1.5e-05,
          "description": "ν of air [m²/s].",
          "exclusiveMinimum": 0,
          "title": "Kinematicviscosity",
          "type": "number"
        },
        "loadFactor": {
          "description": "γQ of the wind and vortex shedding forces.",
          "exclusiveMinimum": 0,
          "title": "Loadfactor",
          "type": "number"
        }
      },
      "required": [
        "strouhal",
        "modeFactor",
        "kwMax",
        "lateral",
        "correlation",
        "damping",
        "speedMargin",
        "loadFactor"
      ],
      "title": "ChimneyRules",
      "type": "object"
    },
    "CoolingTowerRules": {
      "additionalProperties": false,
      "description": "Wind on cooling tower shells: the external pressure around the circumference (1 at the\nwindward line, the least at αmin, the base pressure from αA, SAEngine's cos² shape between\nthe code's points) and the internal suction.",
      "properties": {
        "method": {
          "const": "cylinderDistribution",
          "default": "cylinderDistribution",
          "title": "Method",
          "type": "string"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/CylinderPressureRow"
          },
          "minItems": 1,
          "title": "Rows",
          "type": "array"
        },
        "internal": {
          "description": "Internal pressure coefficient (suction).",
          "maximum": 0,
          "title": "Internal",
          "type": "number"
        },
        "loadFactor": {
          "description": "γQ of the wind.",
          "exclusiveMinimum": 0,
          "title": "Loadfactor",
          "type": "number"
        }
      },
      "required": [
        "rows",
        "internal",
        "loadFactor"
      ],
      "title": "CoolingTowerRules",
      "type": "object"
    },
    "CylinderPressureRow": {
      "additionalProperties": false,
      "description": "The pressure distribution around a circular cylinder at one Reynolds number.",
      "properties": {
        "reynolds": {
          "exclusiveMinimum": 0,
          "title": "Reynolds",
          "type": "number"
        },
        "alphaMin": {
          "description": "Angle of the least pressure [°].",
          "exclusiveMinimum": 0,
          "title": "Alphamin",
          "type": "number"
        },
        "cpMin": {
          "exclusiveMaximum": 0,
          "title": "Cpmin",
          "type": "number"
        },
        "alphaA": {
          "description": "Angle of flow separation [°].",
          "exclusiveMinimum": 0,
          "title": "Alphaa",
          "type": "number"
        },
        "cpBase": {
          "description": "Base pressure behind the separation.",
          "exclusiveMaximum": 0,
          "title": "Cpbase",
          "type": "number"
        }
      },
      "required": [
        "reynolds",
        "alphaMin",
        "cpMin",
        "alphaA",
        "cpBase"
      ],
      "title": "CylinderPressureRow",
      "type": "object"
    },
    "SiloRules": {
      "additionalProperties": false,
      "description": "Silo pressures by Janssen's theory: on filling ph(z) = γ K z0 (1 - e^(-z/z0)), z0 =\nA / (K μ U), pw = μ ph; on discharge × the discharge factors.",
      "properties": {
        "method": {
          "const": "janssen",
          "default": "janssen",
          "title": "Method",
          "type": "string"
        },
        "solids": {
          "additionalProperties": {
            "$ref": "#/$defs/StoredSolid"
          },
          "minProperties": 1,
          "title": "Solids",
          "type": "object"
        },
        "dischargeHorizontal": {
          "description": "Ch on the horizontal pressure.",
          "exclusiveMinimum": 0,
          "title": "Dischargehorizontal",
          "type": "number"
        },
        "dischargeFriction": {
          "description": "Cw on the wall friction.",
          "exclusiveMinimum": 0,
          "title": "Dischargefriction",
          "type": "number"
        },
        "loadFactor": {
          "description": "γF of the stored solid's pressures.",
          "exclusiveMinimum": 0,
          "title": "Loadfactor",
          "type": "number"
        }
      },
      "required": [
        "solids",
        "dischargeHorizontal",
        "dischargeFriction",
        "loadFactor"
      ],
      "title": "SiloRules",
      "type": "object"
    },
    "StoredSolid": {
      "additionalProperties": false,
      "description": "A stored particulate solid: its upper unit weight, angle of internal friction, mean\nlateral pressure ratio and wall friction coefficients by wall type, with the conversion\nfactors to their extreme values.",
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "weight": {
          "description": "Upper characteristic unit weight γu [kN/m³].",
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "number"
        },
        "phi": {
          "description": "Mean angle of internal friction φim [°].",
          "exclusiveMinimum": 0,
          "title": "Phi",
          "type": "number"
        },
        "k": {
          "description": "Mean lateral pressure ratio Km.",
          "exclusiveMinimum": 0,
          "title": "K",
          "type": "number"
        },
        "aK": {
          "description": "Conversion factor of K (upper Km aK, lower Km / aK).",
          "exclusiveMinimum": 0,
          "title": "Ak",
          "type": "number"
        },
        "mu": {
          "additionalProperties": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "description": "Mean wall friction μm by wall type.",
          "title": "Mu",
          "type": "object"
        },
        "aMu": {
          "description": "Conversion factor of μ.",
          "exclusiveMinimum": 0,
          "title": "Amu",
          "type": "number"
        }
      },
      "required": [
        "label",
        "weight",
        "phi",
        "k",
        "aK",
        "mu",
        "aMu"
      ],
      "title": "StoredSolid",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Silos, chimneys and cooling towers: the loads the code gives for them (the shells are\ndesigned by the pack's concrete or steel methods).",
  "properties": {
    "source": {
      "default": "",
      "description": "Clause (and page) the table comes from.",
      "title": "Source",
      "type": "string"
    },
    "sources": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Clause references of single entries: {key: clause}.",
      "title": "Sources",
      "type": "object"
    },
    "clauses": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Short clause references the results cite, by key, without the code's name (e.g. 'Part 6 Sec 2.5.7.3'); read by saengine.codes.context.cite. A key the pack does not give is not cited.",
      "title": "Clauses",
      "type": "object"
    },
    "silos": {
      "anyOf": [
        {
          "$ref": "#/$defs/SiloRules"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "chimneys": {
      "anyOf": [
        {
          "$ref": "#/$defs/ChimneyRules"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "coolingTowers": {
      "anyOf": [
        {
          "$ref": "#/$defs/CoolingTowerRules"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "title": "ShellStructuresTable",
  "type": "object",
  "$id": "saengine.codePack.shellStructures/1"
}
