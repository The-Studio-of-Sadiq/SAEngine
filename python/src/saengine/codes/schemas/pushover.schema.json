    "DisplacementCoefficients": {
      "additionalProperties": false,
      "description": "P3: the coefficients of method ``displacementCoefficient`` (δt = C0·C1·C2·Sa·Te²/4π²·g):\nC1 = 1 + (μ - 1)/(a·Te²) between ``c1PeriodMin`` and ``c1PeriodMax`` (C1 at ``c1PeriodMin``\nbelow it, 1 above ``c1PeriodMax``), C2 = 1 + ((μ - 1)/Te)²/``c2Divisor`` up to\n``c2PeriodMax`` (1 above), μ = Sa/(Vy/W)·Cm.",
      "properties": {
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Clause (and page) of this row.",
          "title": "Source"
        },
        "siteFactors": {
          "additionalProperties": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "description": "The site class factor a of C1, by the pack's site class id.",
          "title": "Sitefactors",
          "type": "object"
        },
        "siteFactorDefault": {
          "description": "a of a site class not listed (the softest soils' value is safe).",
          "exclusiveMinimum": 0,
          "title": "Sitefactordefault",
          "type": "number"
        },
        "c1PeriodMin": {
          "description": "Below this Te [s] C1 is taken at this Te.",
          "exclusiveMinimum": 0,
          "title": "C1Periodmin",
          "type": "number"
        },
        "c1PeriodMax": {
          "description": "Above this Te [s] C1 = 1.",
          "exclusiveMinimum": 0,
          "title": "C1Periodmax",
          "type": "number"
        },
        "c2PeriodMax": {
          "description": "Above this Te [s] C2 = 1.",
          "exclusiveMinimum": 0,
          "title": "C2Periodmax",
          "type": "number"
        },
        "c2Divisor": {
          "description": "The divisor of ((μ - 1)/Te)² in C2.",
          "exclusiveMinimum": 0,
          "title": "C2Divisor",
          "type": "number"
        },
        "massFactor": {
          "default": 1.0,
          "description": "The effective mass factor Cm in μ (1.0, its upper bound, unless the pack gives the system's value).",
          "exclusiveMinimum": 0,
          "title": "Massfactor",
          "type": "number"
        }
      },
      "required": [
        "siteFactors",
        "siteFactorDefault",
        "c1PeriodMin",
        "c1PeriodMax",
        "c2PeriodMax",
        "c2Divisor"
      ],
      "title": "DisplacementCoefficients",
      "type": "object"
    },
    "EquivalentLinearization": {
      "additionalProperties": false,
      "description": "P3: the values of method ``equivalentLinearization`` (effective period and damping of\nthe bilinear SDOF system, the spectrum reduced by B(βeff) = numerator/(constant - ln βeff),\nthe performance point where the capacity spectrum meets the modified demand spectrum).",
      "properties": {
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Clause (and page) of this row.",
          "title": "Source"
        },
        "initialDamping": {
          "description": "β0 of the elastic spectrum [%].",
          "exclusiveMinimum": 0,
          "title": "Initialdamping",
          "type": "number"
        },
        "bands": {
          "description": "The ductilities μ where the low band ends and the high band starts.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          ],
          "title": "Bands",
          "type": "array"
        },
        "low": {
          "$ref": "#/$defs/LinearizationBand",
          "description": "1 < μ < bands[0]: β = A(μ-1)² + B(μ-1)³ + β0, Teff = [G(μ-1)² + H(μ-1)³ + 1]·T0."
        },
        "mid": {
          "$ref": "#/$defs/LinearizationBand",
          "description": "bands[0] ≤ μ ≤ bands[1]: β = C + D(μ-1) + β0, Teff = [I + J(μ-1) + 1]·T0."
        },
        "high": {
          "$ref": "#/$defs/LinearizationBand",
          "description": "μ > bands[1]: β = E·[(F(μ-1) - 1)/(F(μ-1))²]·(Teff/T0)² + β0, Teff = {K·[√((μ-1)/(1 + L(μ-2))) - 1] + 1}·T0."
        },
        "reductionNumerator": {
          "description": "Numerator of B(βeff).",
          "exclusiveMinimum": 0,
          "title": "Reductionnumerator",
          "type": "number"
        },
        "reductionConstant": {
          "description": "Constant of B(βeff) (minus ln βeff[%]).",
          "exclusiveMinimum": 0,
          "title": "Reductionconstant",
          "type": "number"
        },
        "tolerance": {
          "default": 0.05,
          "description": "The trial and the found displacement agree within this share.",
          "exclusiveMinimum": 0,
          "title": "Tolerance",
          "type": "number"
        }
      },
      "required": [
        "initialDamping",
        "bands",
        "low",
        "mid",
        "high",
        "reductionNumerator",
        "reductionConstant"
      ],
      "title": "EquivalentLinearization",
      "type": "object"
    },
