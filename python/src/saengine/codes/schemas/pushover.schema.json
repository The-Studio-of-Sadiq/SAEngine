        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Clause (and page) of this row.",
          "title": "Source"
        },
        "gammaEl": {
          "exclusiveMinimum": 0,
          "title": "Gammael",
          "type": "number"
