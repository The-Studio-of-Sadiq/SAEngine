        "fm",
        "MS",
        "N"
      ],
      "title": "MasonryPrisms",
      "type": "object"
    },
    "MasonryReinforcedShear": {
      "additionalProperties": false,
      "description": "Vnm = masonry [first - slope Mu/(Vu dv)] An √f'm + axialShare Pu; Vns = steelShare\n(Av/s) fy dv; Vn ≤ maxLow An √f'm at Mu/(Vu dv) ≤ 0.25, maxHigh at ≥ 1 [MPa].",
