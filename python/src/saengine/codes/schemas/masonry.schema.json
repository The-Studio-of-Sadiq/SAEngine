        "MS": {
          "description": "Unit strength with type M or S mortar.",
          "items": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "title": "Ms",
          "type": "array"
        },
        "N": {
          "description": "Unit strength with type N mortar.",
