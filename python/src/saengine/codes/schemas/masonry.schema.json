        "first": {
          "exclusiveMinimum": 0,
          "title": "First",
          "type": "number"
        },
        "slope": {
          "exclusiveMinimum": 0,
          "title": "Slope",
          "type": "number"
        },
        "axialShare": {
          "exclusiveMinimum": 0,
          "title": "Axialshare",
          "type": "number"
        },
        "steelShare": {
          "exclusiveMinimum": 0,
          "title": "Steelshare",
          "type": "number"
        },
        "maxLow": {
          "exclusiveMinimum": 0,
          "title": "Maxlow",
          "type": "number"
        },
        "maxHigh": {
          "exclusiveMinimum": 0,
          "title": "Maxhigh",
          "type": "number"
        }
      },
      "required": [
        "masonry",
        "first",
        "slope",
        "axialShare",
        "steelShare",
        "maxLow",
        "maxHigh"
