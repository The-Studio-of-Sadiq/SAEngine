{
  "$defs": {
    "MasonryAxial": {
      "additionalProperties": false,
      "properties": {
        "reduction": {
          "description": "Pn = reduction × [stress × An f'm] × R(h/r).",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Reduction",
          "type": "number"
        },
        "slendernessBreak": {
          "description": "h/r where the long-wall formula starts.",
          "exclusiveMinimum": 0,
          "title": "Slendernessbreak",
          "type": "number"
        },
        "short": {
          "description": "R = 1 - (h / (short r))² up to the break.",
          "exclusiveMinimum": 0,
          "title": "Short",
          "type": "number"
        },
        "long": {
          "description": "R = (long r / h)² above the break.",
          "exclusiveMinimum": 0,
          "title": "Long",
          "type": "number"
        }
      },
      "required": [
        "reduction",
        "slendernessBreak",
        "short",
        "long"
      ],
      "title": "MasonryAxial",
      "type": "object"
    },
    "MasonryOrdinaryWalls": {
      "additionalProperties": false,
      "properties": {
        "maxSpacing": {
          "description": "Largest bar spacing, each way [mm].",
          "exclusiveMinimum": 0,
          "title": "Maxspacing",
          "type": "number"
        },
        "leastBarArea": {
          "description": "Least area of a vertical bar [mm²].",
          "exclusiveMinimum": 0,
          "title": "Leastbararea",
          "type": "number"
        }
      },
      "required": [
        "maxSpacing",
        "leastBarArea"
      ],
      "title": "MasonryOrdinaryWalls",
      "type": "object"
    },
    "MasonryPhi": {
      "additionalProperties": false,
      "description": "φ of masonry (strength design).",
      "properties": {
        "axialFlexureReinforced": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Axialflexurereinforced",
          "type": "number"
        },
        "axialFlexureUnreinforced": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Axialflexureunreinforced",
          "type": "number"
        },
        "shear": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Shear",
          "type": "number"
        },
        "bearing": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Bearing",
          "type": "number"
