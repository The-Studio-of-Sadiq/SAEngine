          "exclusiveMinimum": 0,
          "title": "Runningbond",
          "type": "number"
        },
        "runningBondGrouted": {
          "exclusiveMinimum": 0,
          "title": "Runningbondgrouted",
          "type": "number"
        },
        "stackBond": {
          "exclusiveMinimum": 0,
          "title": "Stackbond",
