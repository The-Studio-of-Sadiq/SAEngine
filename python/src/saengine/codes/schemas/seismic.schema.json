{
  "$defs": {
    "DampingCorrection": {
      "additionalProperties": false,
      "description": "The spectrum's damping correction η(ξ). ``squareRoot``: η = √(numerator / (offset +\n100ξ)), at least ``minimum``; ``none``: η = dampingEta.",
      "properties": {
        "method": {
          "default": "none",
          "enum": [
            "none",
            "squareRoot"
          ],
          "title": "Method",
          "type": "string"
        },
        "referenceDamping": {
          "default": 0.05,
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Referencedamping",
          "type": "number"
        },
        "numerator": {
          "default": 10.0,
          "title": "Numerator",
          "type": "number"
        },
        "offset": {
          "default": 5.0,
          "title": "Offset",
          "type": "number"
        },
        "minimum": {
          "default": 0.0,
          "title": "Minimum",
          "type": "number"
        }
      },
      "title": "DampingCorrection",
      "type": "object"
    },
    "DesignCategories": {
      "additionalProperties": false,
      "properties": {
        "occupancyGroups": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Occupancygroups",
          "type": "object"
        },
        "bySiteClass": {
          "additionalProperties": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "object"
          },
          "title": "Bysiteclass",
          "type": "object"
        },
        "aliases": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "object"
        }
      },
      "required": [
        "occupancyGroups",
        "bySiteClass"
      ],
      "title": "DesignCategories",
      "type": "object"
    },
    "DiaphragmDeflection": {
      "additionalProperties": false,
      "description": "In-plane diaphragm deflection limit [mm]; empty: the code gives no number (the\npermissible deflection of the attached elements, which the engineer enters).",
      "properties": {
        "limit": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit"
        }
      },
      "title": "DiaphragmDeflection",
      "type": "object"
    },
    "DriftLimit": {
      "additionalProperties": false,
      "description": "A row of the allowable storey drift table; the first row whose conditions hold applies\n(a condition left empty always holds), else ``allowableDrift``.",
      "properties": {
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Clause (and page) of this row.",
          "title": "Source"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "masonry": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The system is a masonry one.",
          "title": "Masonry"
        },
        "cantileverWalls": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The walls are cantilevered from the base (no coupling).",
          "title": "Cantileverwalls"
        },
        "maxStoreys": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxstoreys"
        },
        "driftTolerantFinishes": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Interior walls, partitions, ceilings and exterior walls designed to accommodate the storey drift.",
          "title": "Drifttolerantfinishes"
        },
        "limits": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Δa/hsx by occupancy category.",
          "title": "Limits",
          "type": "object"
        }
      },
      "required": [
        "id",
        "label",
        "limits"
      ],
      "title": "DriftLimit",
      "type": "object"
    },
    "PeriodCoefficient": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Clause (and page) of this row.",
          "title": "Source"
        },
        "Ct": {
          "exclusiveMinimum": 0,
          "title": "Ct",
          "type": "number"
        },
        "m": {
          "exclusiveMinimum": 0,
          "title": "M",
          "type": "number"
        }
      },
      "required": [
        "Ct",
        "m"
      ],
      "title": "PeriodCoefficient",
      "type": "object"
    },
    "Separation": {
      "additionalProperties": false,
      "description": "Separation from adjacent structures: the gap to the property line is at least\n``propertyLineFactor``·δ; between units of one property the ``sameProperty`` combination\n(\"srss\" or \"sum\") of the two δ; times ``equalFloorLevelsFactor`` where the floors align.",
      "properties": {
        "propertyLineFactor": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Propertylinefactor",
          "type": "number"
        },
        "sameProperty": {
          "default": "srss",
          "enum": [
            "srss",
            "sum"
          ],
          "title": "Sameproperty",
          "type": "string"
        },
        "equalFloorLevelsFactor": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Equalfloorlevelsfactor",
          "type": "number"
        }
      },
      "title": "Separation",
      "type": "object"
    },
    "SiteClass": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Clause (and page) of this row.",
          "title": "Source"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "S": {
          "description": "Soil factor.",
          "exclusiveMinimum": 0,
          "title": "S",
          "type": "number"
        },
        "TB": {
          "minimum": 0,
          "title": "Tb",
          "type": "number"
        },
        "TC": {
          "minimum": 0,
          "title": "Tc",
          "type": "number"
        },
        "TD": {
          "minimum": 0,
          "title": "Td",
          "type": "number"
        }
      },
      "required": [
        "description",
        "S",
        "TB",
        "TC",
        "TD"
      ],
      "title": "SiteClass",
      "type": "object"
    },
    "SiteSpecificStudy": {
      "additionalProperties": false,
      "description": "Site classes the code gives no spectrum for: they need a site-specific study.",
      "properties": {
        "classes": {
          "items": {
            "type": "string"
          },
          "title": "Classes",
          "type": "array"
        },
        "assumedClass": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assumedclass"
        },
        "clause": {
          "default": "",
          "title": "Clause",
          "type": "string"
        },
        "warning": {
          "default": "",
          "title": "Warning",
          "type": "string"
        }
      },
      "title": "SiteSpecificStudy",
      "type": "object"
    },
    "StructuralSystem": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Clause (and page) of this row.",
          "title": "Source"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "R": {
          "exclusiveMinimum": 0,
          "title": "R",
          "type": "number"
        },
        "Omega0": {
          "exclusiveMinimum": 0,
          "title": "Omega0",
          "type": "number"
        },
        "Cd": {
          "exclusiveMinimum": 0,
          "title": "Cd",
          "type": "number"
        },
        "row": {
          "default": "",
          "description": "Row of the code's system table.",
          "title": "Row",
          "type": "string"
        },
        "heightLimits": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Heightlimits",
          "type": "object"
        },
        "frame": {
          "anyOf": [
            {
              "enum": [
                "special",
                "intermediate",
                "ordinary"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame"
        },
        "specialWalls": {
          "default": false,
          "title": "Specialwalls",
          "type": "boolean"
        },
        "concrete": {
          "default": true,
          "title": "Concrete",
          "type": "boolean"
        },
        "masonry": {
          "default": false,
          "description": "A masonry system: its walls are designed as masonry.",
          "title": "Masonry",
          "type": "boolean"
        },
        "momentFrame": {
          "default": false,
          "title": "Momentframe",
          "type": "boolean"
        },
        "periodFamily": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Periodfamily"
        },
        "group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Group of the code's system table (bearingWall, dualSpecial...).",
          "title": "Group"
        },
        "dual": {
          "default": false,
          "description": "A dual system (one row of the table).",
          "title": "Dual",
          "type": "boolean"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "name",
        "R",
        "Omega0",
        "Cd"
      ],
      "title": "StructuralSystem",
      "type": "object"
    },
    "SystemCombination": {
      "additionalProperties": false,
      "description": "How the values of several systems in one direction combine: \"min\" or \"max\".",
      "properties": {
        "R": {
          "default": "min",
          "enum": [
            "min",
            "max"
          ],
          "title": "R",
          "type": "string"
        },
        "Cd": {
          "default": "max",
          "enum": [
            "min",
            "max"
          ],
          "title": "Cd",
          "type": "string"
        },
        "Omega0": {
          "default": "max",
          "enum": [
            "min",
            "max"
          ],
          "title": "Omega0",
          "type": "string"
        },
        "heightLimit": {
          "default": "min",
          "enum": [
            "min",
            "max"
          ],
          "title": "Heightlimit",
          "type": "string"
        }
      },
      "title": "SystemCombination",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Site classes, spectrum, systems, SDC and the plain numbers of the seismic analysis.",
  "properties": {
    "source": {
      "default": "",
      "description": "Clause (and page) the table comes from.",
      "title": "Source",
      "type": "string"
    },
    "sources": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Clause references of single entries: {key: clause}.",
      "title": "Sources",
      "type": "object"
    },
    "siteClasses": {
      "additionalProperties": {
        "$ref": "#/$defs/SiteClass"
      },
      "title": "Siteclasses",
      "type": "object"
    },
    "systems": {
      "additionalProperties": {
        "$ref": "#/$defs/StructuralSystem"
      },
      "title": "Systems",
      "type": "object"
    },
    "periodCoefficients": {
      "additionalProperties": {
        "$ref": "#/$defs/PeriodCoefficient"
      },
      "title": "Periodcoefficients",
      "type": "object"
    },
    "designCategories": {
      "$ref": "#/$defs/DesignCategories"
    },
    "requiredDetailing": {
      "additionalProperties": {
        "enum": [
          "special",
          "intermediate",
          "ordinary"
        ],
        "type": "string"
      },
      "title": "Requireddetailing",
      "type": "object"
    },
    "allowableDrift": {
      "additionalProperties": {
        "type": "number"
      },
      "description": "Δa/hsx by occupancy category.",
      "title": "Allowabledrift",
      "type": "object"
    },
    "allowableDriftLabel": {
      "default": "",
      "description": "The structures allowableDrift is for.",
      "title": "Allowabledriftlabel",
      "type": "string"
    },
    "driftLimits": {
      "description": "Rows of the drift table before allowableDrift.",
      "items": {
        "$ref": "#/$defs/DriftLimit"
      },
      "title": "Driftlimits",
      "type": "array"
    },
    "driftRedundancyCategories": {
      "description": "Seismic Design Categories where the drift limit of systems of moment frames only is divided by the redundancy factor ρ.",
      "items": {
        "type": "string"
      },
      "title": "Driftredundancycategories",
      "type": "array"
    },
    "siteSpecificStudy": {
      "$ref": "#/$defs/SiteSpecificStudy"
    },
    "dampingEta": {
      "default": 1.0,
      "title": "Dampingeta",
      "type": "number"
    },
    "dampingCorrection": {
      "$ref": "#/$defs/DampingCorrection"
    },
    "systemCombination": {
      "$ref": "#/$defs/SystemCombination"
    },
    "separation": {
      "$ref": "#/$defs/Separation"
    },
    "diaphragmDeflection": {
      "$ref": "#/$defs/DiaphragmDeflection"
    },
    "clauses": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Clause references of the seismic results, by key.",
      "title": "Clauses",
      "type": "object"
    },
    "liveShare": {
      "description": "Share of the floor live load in the seismic weight.",
      "title": "Liveshare",
      "type": "number"
    },
    "heavyLiveLimit": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Live loads above this [kN/m²] count in the seismic weight with heavyLiveShare (empty: every live load with liveShare).",
      "title": "Heavylivelimit"
    },
    "heavyLiveShare": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Share of a heavy live load in the seismic weight.",
      "title": "Heavyliveshare"
    },
    "periodUpperFactor": {
      "anyOf": [
        {
          "exclusiveMinimum": 1,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "A period from the structure's properties is at most this times the approximate period Ta (empty: 1.4).",
      "title": "Periodupperfactor"
    },
    "minimumScale": {
      "description": "Least share of the static base shear for RS.",
      "title": "Minimumscale",
      "type": "number"
    },
    "accidentalEccentricity": {
      "title": "Accidentaleccentricity",
      "type": "number"
    },
    "orthogonalShare": {
      "title": "Orthogonalshare",
      "type": "number"
    },
    "massParticipation": {
      "title": "Massparticipation",
      "type": "number"
    },
    "torsionIrregular": {
      "title": "Torsionirregular",
      "type": "number"
    },
    "torsionExtreme": {
      "title": "Torsionextreme",
      "type": "number"
    },
    "torsionAmplificationMax": {
      "title": "Torsionamplificationmax",
      "type": "number"
    },
    "pgaFactor": {
      "description": "a_h = pgaFactor · Z · S.",
      "title": "Pgafactor",
      "type": "number"
    },
    "verticalFactor": {
      "description": "Ev = verticalFactor · a_h · D.",
      "title": "Verticalfactor",
      "type": "number"
    }
  },
  "required": [
    "siteClasses",
    "systems",
    "periodCoefficients",
    "designCategories",
    "requiredDetailing",
    "allowableDrift",
    "liveShare",
    "minimumScale",
    "accidentalEccentricity",
    "orthogonalShare",
    "massParticipation",
    "torsionIrregular",
    "torsionExtreme",
    "torsionAmplificationMax",
    "pgaFactor",
    "verticalFactor"
  ],
  "title": "SeismicTable",
  "type": "object",
  "$id": "saengine.codePack.seismic/1"
}
