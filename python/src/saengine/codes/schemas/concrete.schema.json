{
  "$defs": {
    "AggregateRules": {
      "additionalProperties": false,
      "description": "What an aggregate type (Project Settings > Construction) changes in the concrete.",
      "properties": {
        "modulus": {
          "description": "Ec rule: normal weight, the density form (lightweight), brick aggregate.",
          "enum": [
            "normal",
            "density",
            "brick"
          ],
          "title": "Modulus",
          "type": "string"
        },
        "lambda": {
          "description": "Lightweight modification factor λ on √f'c.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Lambda",
          "type": "number"
        },
        "shrinkageFactor": {
          "default": 1.0,
          "description": "Shrinkage and temperature steel × this.",
          "minimum": 1,
          "title": "Shrinkagefactor",
          "type": "number"
        }
      },
      "required": [
        "modulus",
        "lambda"
      ],
      "title": "AggregateRules",
      "type": "object"
    },
    "BarDiameters": {
      "additionalProperties": {
        "items": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          ]
        },
        "type": "array"
      },
      "description": "Bar size sets [mm] by use (extra sets allowed; an extra set keeps its sizes as printed,\nintegers or decimals: 9 Substructure's minimum mesh is written as given).",
      "properties": {
        "all": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "minItems": 1,
          "title": "All",
          "type": "array"
        },
        "main": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "minItems": 1,
          "title": "Main",
          "type": "array"
        },
        "column": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "minItems": 1,
          "title": "Column",
          "type": "array"
        },
        "slab": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "minItems": 1,
          "title": "Slab",
          "type": "array"
        },
        "stirrup": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "minItems": 1,
          "title": "Stirrup",
          "type": "array"
        },
        "wall": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "minItems": 1,
          "title": "Wall",
          "type": "array"
        },
        "boundary": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "minItems": 1,
          "title": "Boundary",
          "type": "array"
        },
        "hoop": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "minItems": 1,
          "title": "Hoop",
          "type": "array"
        },
        "lintel": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "minItems": 1,
          "title": "Lintel",
          "type": "array"
        }
      },
      "required": [
        "all",
        "main",
        "column",
        "slab",
        "stirrup",
        "wall",
        "boundary",
        "hoop",
        "lintel"
      ],
      "title": "BarDiameters",
      "type": "object"
    },
    "Covers": {
      "additionalProperties": false,
      "description": "Assumed clear covers [mm] by element.",
      "properties": {
        "lintel": {
          "exclusiveMinimum": 0,
          "title": "Lintel",
          "type": "number"
        },
        "stair": {
          "exclusiveMinimum": 0,
          "title": "Stair",
          "type": "number"
        },
        "pileCap": {
          "exclusiveMinimum": 0,
          "title": "Pilecap",
          "type": "number"
        }
      },
      "required": [
        "lintel",
        "stair",
        "pileCap"
      ],
      "title": "Covers",
      "type": "object"
    },
    "CrackedStiffness": {
      "additionalProperties": false,
      "description": "Cracked-section stiffness factors (share of the gross moment of inertia).",
      "properties": {
        "column": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Column",
          "type": "number"
        },
        "beam": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Beam",
          "type": "number"
        },
        "plate": {
          "description": "Flat plates and flat slabs.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Plate",
          "type": "number"
        },
        "wall": {
          "description": "Cracked walls.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Wall",
          "type": "number"
        },
        "wallUncracked": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Walls taken as uncracked (Project Settings > Analysis > Walls cracked off); the column factor when not given.",
          "title": "Walluncracked"
        }
      },
      "required": [
        "column",
        "beam",
        "plate",
        "wall"
      ],
      "title": "CrackedStiffness",
      "type": "object"
    },
    "DeflectionLimitsGroup": {
      "additionalProperties": false,
      "description": "Span divisors of the computed deflection limits, ξ and the cantilever thickness divisors\n(BNBC 2020 Part 6 Sec 6.2.5).",
      "properties": {
        "liveFloor": {
          "description": "Floors: immediate live-load deflection <= l/this.",
          "exclusiveMinimum": 0,
          "title": "Livefloor",
          "type": "number"
        },
        "liveRoof": {
          "description": "Flat roofs: immediate live-load deflection.",
          "exclusiveMinimum": 0,
          "title": "Liveroof",
          "type": "number"
        },
        "attachedSensitive": {
          "description": "After attachment, elements likely to be damaged: l/this.",
          "exclusiveMinimum": 0,
          "title": "Attachedsensitive",
          "type": "number"
        },
        "attachedInsensitive": {
          "description": "After attachment, elements not likely to be damaged: l/this.",
          "exclusiveMinimum": 0,
          "title": "Attachedinsensitive",
          "type": "number"
        },
        "xi": {
          "additionalProperties": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "description": "Months -> ξ.",
          "minProperties": 1,
          "title": "Xi",
          "type": "object"
        },
        "cantileverBeam": {
          "description": "Least beam depth of a cantilever: l/this.",
          "exclusiveMinimum": 0,
          "title": "Cantileverbeam",
          "type": "number"
        },
        "cantileverSlab": {
          "description": "Least slab thickness of a cantilever: l/this.",
          "exclusiveMinimum": 0,
          "title": "Cantileverslab",
          "type": "number"
        }
      },
      "required": [
        "liveFloor",
        "liveRoof",
        "attachedSensitive",
        "attachedInsensitive",
        "xi",
        "cantileverBeam",
        "cantileverSlab"
      ],
      "title": "DeflectionLimitsGroup",
      "type": "object"
    },
    "ModulusRules": {
      "additionalProperties": false,
      "description": "Modulus of elasticity Ec of concrete [MPa] (f'c in MPa, wc in kg/m³).",
      "properties": {
        "normal": {
          "description": "Normal weight: Ec = this √f'c.",
          "exclusiveMinimum": 0,
          "title": "Normal",
          "type": "number"
        },
        "brick": {
          "description": "Brick aggregate: Ec = this √f'c.",
          "exclusiveMinimum": 0,
          "title": "Brick",
          "type": "number"
        },
        "densityCoefficient": {
          "description": "Ec = this wc^exponent √f'c.",
          "exclusiveMinimum": 0,
          "title": "Densitycoefficient",
          "type": "number"
        },
        "densityExponent": {
          "exclusiveMinimum": 0,
          "title": "Densityexponent",
          "type": "number"
        },
        "densityRange": {
          "description": "wc [kg/m³] within which the density form applies.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          ],
          "title": "Densityrange",
          "type": "array"
        }
      },
      "required": [
        "normal",
        "brick",
        "densityCoefficient",
        "densityExponent",
        "densityRange"
      ],
      "title": "ModulusRules",
      "type": "object"
    },
    "PrestressAnchorage": {
      "additionalProperties": false,
      "description": "Post-tensioned anchorage zones: Ppu = loadFactor × the jacking force, φ; spalling steel\n``spalling`` × Ppu (not for monostrand slab tendons); f'ci at stressing; the slab edge bars\nand hairpins of monostrand slab anchors; bursting.",
      "properties": {
        "loadFactor": {
          "exclusiveMinimum": 0,
          "title": "Loadfactor",
          "type": "number"
        },
        "phi": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Phi",
          "type": "number"
        },
        "spalling": {
          "exclusiveMinimum": 0,
          "title": "Spalling",
          "type": "number"
        },
        "transferMulti": {
          "exclusiveMinimum": 0,
          "title": "Transfermulti",
          "type": "number"
        },
        "transferSingle": {
          "exclusiveMinimum": 0,
          "title": "Transfersingle",
          "type": "number"
        },
        "monostrandArea": {
          "exclusiveMinimum": 0,
          "title": "Monostrandarea",
          "type": "number"
        },
        "edgeBars": {
          "minimum": 1,
          "title": "Edgebars",
          "type": "integer"
        },
        "edgeBarDia": {
          "exclusiveMinimum": 0,
          "title": "Edgebardia",
          "type": "number"
        },
        "edgeBarAhead": {
          "exclusiveMinimum": 0,
          "title": "Edgebarahead",
          "type": "number"
        },
        "edgeBarExtension": {
          "exclusiveMinimum": 0,
          "title": "Edgebarextension",
          "type": "number"
        },
        "groupSpacing": {
          "exclusiveMinimum": 0,
          "title": "Groupspacing",
          "type": "number"
        },
        "groupMin": {
          "minimum": 1,
          "title": "Groupmin",
          "type": "integer"
        },
        "hairpinDia": {
          "exclusiveMinimum": 0,
          "title": "Hairpindia",
          "type": "number"
        },
        "hairpinFrom": {
          "exclusiveMinimum": 0,
          "title": "Hairpinfrom",
          "type": "number"
        },
        "hairpinTo": {
          "exclusiveMinimum": 0,
          "title": "Hairpinto",
          "type": "number"
        },
        "bursting": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrestressBursting"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "loadFactor",
        "phi",
        "spalling",
        "transferMulti",
        "transferSingle",
        "monostrandArea",
        "edgeBars",
        "edgeBarDia",
        "edgeBarAhead",
        "edgeBarExtension",
        "groupSpacing",
        "groupMin",
        "hairpinDia",
        "hairpinFrom",
        "hairpinTo"
      ],
      "title": "PrestressAnchorage",
      "type": "object"
    },
    "PrestressBondedTop": {
      "additionalProperties": false,
      "description": "Bonded top bars over the columns of two-way slabs: at least ``minBars`` bars at most\n``maxSpacing`` [mm] apart between lines ``beyondFace`` × h outside the column faces; bars\n``negativeLength`` × ln each side of the support, bottom bars ``positiveLength`` × ln.",
      "properties": {
        "minBars": {
          "minimum": 1,
          "title": "Minbars",
          "type": "integer"
        },
        "maxSpacing": {
          "exclusiveMinimum": 0,
          "title": "Maxspacing",
          "type": "number"
        },
        "beyondFace": {
          "exclusiveMinimum": 0,
          "title": "Beyondface",
          "type": "number"
        },
        "negativeLength": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Negativelength",
          "type": "number"
        },
        "positiveLength": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Positivelength",
          "type": "number"
        }
      },
      "required": [
        "minBars",
        "maxSpacing",
        "beyondFace",
        "negativeLength",
        "positiveLength"
      ],
      "title": "PrestressBondedTop",
      "type": "object"
    },
    "PrestressBursting": {
      "additionalProperties": false,
      "description": "General zone bursting by simplified equations: T = share Ppu (1 - a/h), d = depthShare\n(h - 2e).",
      "properties": {
        "method": {
          "const": "simplified",
          "title": "Method",
          "type": "string"
        },
        "share": {
          "exclusiveMinimum": 0,
          "title": "Share",
          "type": "number"
        },
        "depthShare": {
          "exclusiveMinimum": 0,
          "title": "Depthshare",
          "type": "number"
        }
      },
      "required": [
        "method",
        "share",
        "depthShare"
      ],
      "title": "PrestressBursting",
      "type": "object"
    },
    "PrestressCompression": {
      "additionalProperties": false,
      "description": "Prestressed compression members: above ``threshold`` [MPa] of effective prestress, ties\nof at least ``tieMinDia`` at most ``tieSpacingDiameters`` tie diameters (and the least\ndimension) apart, or spirals ρs >= spiralCoefficient (Ag/Ach - 1) f'c / fyt, fyt <=\nspiralFytMax.",
      "properties": {
        "threshold": {
          "exclusiveMinimum": 0,
          "title": "Threshold",
          "type": "number"
        },
        "tieMinDia": {
          "exclusiveMinimum": 0,
          "title": "Tiemindia",
          "type": "number"
        },
        "tieSpacingDiameters": {
          "exclusiveMinimum": 0,
          "title": "Tiespacingdiameters",
          "type": "number"
        },
        "spiralCoefficient": {
          "exclusiveMinimum": 0,
          "title": "Spiralcoefficient",
          "type": "number"
        },
        "spiralFytMax": {
          "exclusiveMinimum": 0,
          "title": "Spiralfytmax",
          "type": "number"
        }
      },
      "required": [
        "threshold",
        "tieMinDia",
        "tieSpacingDiameters",
        "spiralCoefficient",
        "spiralFytMax"
      ],
      "title": "PrestressCompression",
      "type": "object"
    },
    "PrestressCracking": {
      "additionalProperties": false,
      "description": "Members with bonded tendons: φMn >= factor × Mcr, waived where the strength is at least\nwaiver × the required strength.",
      "properties": {
        "factor": {
          "exclusiveMinimum": 0,
          "title": "Factor",
          "type": "number"
        },
        "waiver": {
          "exclusiveMinimum": 0,
          "title": "Waiver",
          "type": "number"
        }
      },
      "required": [
        "factor",
        "waiver"
      ],
      "title": "PrestressCracking",
      "type": "object"
    },
    "PrestressIntegrity": {
      "additionalProperties": false,
      "description": "Slabs with unbonded tendons: at least ``strands`` strands of ``strandArea`` [mm²] or more\neach way through the column (its section less ``coreInset`` [mm] each side), else bottom\nbars through it of at least bottomFactor × bottomRoot √f'c bw d / fy and bottomMin bw d /\nfy.",
      "properties": {
        "strands": {
          "minimum": 1,
          "title": "Strands",
          "type": "integer"
        },
        "strandArea": {
          "exclusiveMinimum": 0,
          "title": "Strandarea",
          "type": "number"
        },
        "coreInset": {
          "minimum": 0,
          "title": "Coreinset",
          "type": "number"
        },
        "bottomFactor": {
          "exclusiveMinimum": 0,
          "title": "Bottomfactor",
          "type": "number"
        },
        "bottomRoot": {
          "exclusiveMinimum": 0,
          "title": "Bottomroot",
          "type": "number"
        },
        "bottomMin": {
          "exclusiveMinimum": 0,
          "title": "Bottommin",
          "type": "number"
        }
      },
      "required": [
        "strands",
        "strandArea",
        "coreInset",
        "bottomFactor",
        "bottomRoot",
        "bottomMin"
      ],
      "title": "PrestressIntegrity",
      "type": "object"
    },
    "PrestressLimits": {
      "additionalProperties": false,
      "description": "Prestressed concrete (the pack's prestressed chapter; the default pack's clauses are in\n``concrete.sources.prestress``): stress limits as\nmultiples of f'ci, f'c or √f'c [MPa], the stress in unbonded tendons at nominal strength,\nthe bonded reinforcement, precompression and tendon spacing, and punching with\nprestress.",
      "properties": {
        "jackingFpu": {
          "description": "Jacking stress <= this × fpu.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Jackingfpu",
          "type": "number"
        },
        "jackingFpy": {
          "description": "Jacking stress <= this × fpy.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Jackingfpy",
          "type": "number"
        },
        "anchorFpu": {
          "description": "At the anchors immediately after transfer: stress <= this × fpu.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Anchorfpu",
          "type": "number"
        },
        "transferCompression": {
          "description": "At transfer: compression <= this f'ci.",
          "exclusiveMinimum": 0,
          "title": "Transfercompression",
          "type": "number"
        },
        "transferTension": {
          "description": "At transfer: tension <= this √f'ci.",
          "exclusiveMinimum": 0,
          "title": "Transfertension",
          "type": "number"
        },
        "transferTensionEnds": {
          "description": "At transfer, at the ends of simply supported members: this √f'ci.",
          "exclusiveMinimum": 0,
          "title": "Transfertensionends",
          "type": "number"
        },
        "sustainedCompression": {
          "description": "Service, sustained load: compression <= this f'c.",
          "exclusiveMinimum": 0,
          "title": "Sustainedcompression",
          "type": "number"
        },
        "totalCompression": {
          "description": "Service, total load: compression <= this f'c.",
          "exclusiveMinimum": 0,
          "title": "Totalcompression",
          "type": "number"
        },
        "tensionTwoWay": {
          "description": "Two-way slabs, service tension <= this √f'c.",
          "exclusiveMinimum": 0,
          "title": "Tensiontwoway",
          "type": "number"
        },
        "tensionClassU": {
          "description": "Class U (uncracked) tension <= this √f'c.",
          "exclusiveMinimum": 0,
          "title": "Tensionclassu",
          "type": "number"
        },
        "unbondedAdd": {
          "description": "Unbonded fps = fse + this + f'c / (k ρp) [MPa].",
          "exclusiveMinimum": 0,
          "title": "Unbondedadd",
          "type": "number"
        },
        "unbondedSpanDepth": {
          "description": "Span / depth dividing the two expressions.",
          "exclusiveMinimum": 0,
          "title": "Unbondedspandepth",
          "type": "number"
        },
        "unbondedK": {
          "description": "k up to and above the span/depth.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          ],
          "title": "Unbondedk",
          "type": "array"
        },
        "unbondedCap": {
          "description": "fps <= fse + this [MPa], up to and above the span/depth.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          ],
          "title": "Unbondedcap",
          "type": "array"
        },
        "gammaP": {
          "description": "γp of bonded fps (fpy / fpu >= 0.9).",
          "exclusiveMinimum": 0,
          "title": "Gammap",
          "type": "number"
        },
        "bondedNegative": {
          "description": "Two-way slabs: bonded top bars over the columns As >= this Acf.",
          "exclusiveMinimum": 0,
          "title": "Bondednegative",
          "type": "number"
        },
        "bondedPositiveTension": {
          "description": "Two-way slabs: bonded bottom bars needed when tension > this √f'c.",
          "exclusiveMinimum": 0,
          "title": "Bondedpositivetension",
          "type": "number"
        },
        "bondedPositiveStress": {
          "description": "As = Nc / (this × fy).",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Bondedpositivestress",
          "type": "number"
        },
        "bondedOneWay": {
          "description": "Unbonded one-way: As >= this × Act.",
          "exclusiveMinimum": 0,
          "title": "Bondedoneway",
          "type": "number"
        },
        "minPrecompression": {
          "description": "Average precompression >= this [MPa].",
          "exclusiveMinimum": 0,
          "title": "Minprecompression",
          "type": "number"
        },
        "spacingThickness": {
          "description": "Distributed tendons apart <= this × h.",
          "exclusiveMinimum": 0,
          "title": "Spacingthickness",
          "type": "number"
        },
        "spacingMax": {
          "description": "... and <= this [mm].",
          "exclusiveMinimum": 0,
          "title": "Spacingmax",
          "type": "number"
        },
        "punchingBetaMax": {
          "description": "βp <= this.",
          "exclusiveMinimum": 0,
          "title": "Punchingbetamax",
          "type": "number"
        },
        "punchingBetaA": {
          "description": "βp = this (1.5 + αs d / b0).",
          "exclusiveMinimum": 0,
          "title": "Punchingbetaa",
          "type": "number"
        },
        "punchingFpc": {
          "description": "vc adds this × fpc.",
          "exclusiveMinimum": 0,
          "title": "Punchingfpc",
          "type": "number"
        },
        "punchingFpcRange": {
          "description": "fpc each way within this range [MPa] for the expression to apply.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          ],
          "title": "Punchingfpcrange",
          "type": "array"
        },
        "punchingRootMax": {
          "description": "√f'c <= this [MPa] in the expression.",
          "exclusiveMinimum": 0,
          "title": "Punchingrootmax",
          "type": "number"
        },
        "punchingMethod": {
          "default": "precompression",
          "description": "Punching at the columns of prestressed slabs: 'precompression' (βp √f'c + fpc term above) or 'reinforced' (the nonprestressed vc, no prestress term).",
          "enum": [
            "precompression",
            "reinforced"
          ],
          "title": "Punchingmethod",
          "type": "string"
        },
        "transferSteelFpy": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tendon stress immediately after transfer <= this × fpy.",
          "title": "Transfersteelfpy"
