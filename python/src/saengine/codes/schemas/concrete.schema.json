{
  "$defs": {
    "BarDiameters": {
      "additionalProperties": {
        "items": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          ]
        },
        "type": "array"
      },
      "description": "Bar size sets [mm] by use (extra sets allowed; an extra set keeps its sizes as printed,\nintegers or decimals: 9 Substructure's minimum mesh is written as given).",
      "properties": {
        "all": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "minItems": 1,
          "title": "All",
          "type": "array"
        },
        "main": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "minItems": 1,
          "title": "Main",
          "type": "array"
        },
        "column": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "minItems": 1,
          "title": "Column",
          "type": "array"
        },
        "slab": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "minItems": 1,
          "title": "Slab",
          "type": "array"
        },
        "stirrup": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "minItems": 1,
          "title": "Stirrup",
          "type": "array"
        },
        "wall": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "minItems": 1,
          "title": "Wall",
          "type": "array"
        },
        "boundary": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "minItems": 1,
          "title": "Boundary",
          "type": "array"
        },
        "hoop": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "minItems": 1,
          "title": "Hoop",
          "type": "array"
        },
        "lintel": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "minItems": 1,
          "title": "Lintel",
          "type": "array"
        }
      },
      "required": [
        "all",
        "main",
        "column",
        "slab",
        "stirrup",
        "wall",
        "boundary",
        "hoop",
        "lintel"
      ],
      "title": "BarDiameters",
      "type": "object"
    },
    "Covers": {
      "additionalProperties": false,
      "description": "Assumed clear covers [mm] by element.",
      "properties": {
        "lintel": {
          "exclusiveMinimum": 0,
          "title": "Lintel",
          "type": "number"
        },
        "stair": {
          "exclusiveMinimum": 0,
          "title": "Stair",
          "type": "number"
        },
        "pileCap": {
          "exclusiveMinimum": 0,
          "title": "Pilecap",
          "type": "number"
        }
      },
      "required": [
        "lintel",
        "stair",
        "pileCap"
      ],
      "title": "Covers",
      "type": "object"
    },
    "CrackedStiffness": {
      "additionalProperties": false,
      "description": "Cracked-section stiffness factors (share of the gross moment of inertia).",
      "properties": {
        "column": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Column",
          "type": "number"
        },
        "beam": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Beam",
          "type": "number"
        },
        "plate": {
          "description": "Flat plates and flat slabs.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Plate",
          "type": "number"
        },
        "wall": {
          "description": "Cracked walls.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Wall",
          "type": "number"
        },
        "wallUncracked": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Walls taken as uncracked (Project Settings > Analysis > Walls cracked off); the column factor when not given.",
          "title": "Walluncracked"
        }
      },
      "required": [
        "column",
        "beam",
        "plate",
        "wall"
      ],
      "title": "CrackedStiffness",
      "type": "object"
    },
    "DeflectionLimitsGroup": {
      "additionalProperties": false,
      "description": "Span divisors of the computed deflection limits, ξ and the cantilever thickness divisors\n(BNBC 2020 Part 6 Sec 6.2.5).",
      "properties": {
        "liveFloor": {
          "description": "Floors: immediate live-load deflection <= l/this.",
          "exclusiveMinimum": 0,
          "title": "Livefloor",
          "type": "number"
        },
        "liveRoof": {
          "description": "Flat roofs: immediate live-load deflection.",
          "exclusiveMinimum": 0,
          "title": "Liveroof",
          "type": "number"
        },
        "attachedSensitive": {
          "description": "After attachment, elements likely to be damaged: l/this.",
          "exclusiveMinimum": 0,
          "title": "Attachedsensitive",
          "type": "number"
        },
        "attachedInsensitive": {
          "description": "After attachment, elements not likely to be damaged: l/this.",
          "exclusiveMinimum": 0,
          "title": "Attachedinsensitive",
          "type": "number"
        },
        "xi": {
          "additionalProperties": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "description": "Months -> ξ.",
          "minProperties": 1,
          "title": "Xi",
          "type": "object"
        },
        "cantileverBeam": {
          "description": "Least beam depth of a cantilever: l/this.",
          "exclusiveMinimum": 0,
          "title": "Cantileverbeam",
          "type": "number"
        },
        "cantileverSlab": {
          "description": "Least slab thickness of a cantilever: l/this.",
          "exclusiveMinimum": 0,
          "title": "Cantileverslab",
          "type": "number"
        }
      },
      "required": [
        "liveFloor",
        "liveRoof",
        "attachedSensitive",
        "attachedInsensitive",
        "xi",
        "cantileverBeam",
        "cantileverSlab"
      ],
      "title": "DeflectionLimitsGroup",
      "type": "object"
    },
    "SlenderLimits": {
      "additionalProperties": false,
      "description": "Slender column limits (moment magnifier method).",
      "properties": {
        "nonswayQ": {
          "description": "Stability index Q at or below which a storey is nonsway.",
          "exclusiveMinimum": 0,
          "title": "Nonswayq",
          "type": "number"
        },
        "swayLimit": {
          "description": "k·lu/r below which a sway column is short.",
          "exclusiveMinimum": 0,
          "title": "Swaylimit",
          "type": "number"
        },
        "nonswayCap": {
          "description": "Upper cap of the nonsway k·lu/r limit.",
          "exclusiveMinimum": 0,
          "title": "Nonswaycap",
          "type": "number"
        },
        "kluRMax": {
          "description": "k·lu/r above which second-order analysis is required.",
          "exclusiveMinimum": 0,
          "title": "Klurmax",
          "type": "number"
        },
        "deltaSMax": {
          "description": "δs above which second-order analysis is required.",
          "minimum": 1,
          "title": "Deltasmax",
          "type": "number"
        },
        "momentRatioMax": {
          "description": "M2 (2nd order)/M2 (1st order) limit.",
          "minimum": 1,
          "title": "Momentratiomax",
          "type": "number"
        }
      },
      "required": [
        "nonswayQ",
        "swayLimit",
        "nonswayCap",
        "kluRMax",
        "deltaSMax",
        "momentRatioMax"
      ],
      "title": "SlenderLimits",
      "type": "object"
    },
    "TorsionLimits": {
      "additionalProperties": false,
      "description": "Limits and choices of the torsion design of beams (BNBC 2020 Part 6 Sec 6.4.4).",
      "properties": {
        "theta": {
          "description": "Angle θ of the compression diagonals [°].",
          "maximum": 60,
          "minimum": 30,
          "title": "Theta",
          "type": "number"
        },
        "aoShare": {
          "description": "Ao / Aoh.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Aoshare",
          "type": "number"
        },
        "spacingMax": {
          "description": "Largest spacing of closed stirrups [mm].",
          "exclusiveMinimum": 0,
          "title": "Spacingmax",
          "type": "number"
        },
        "perimeterDivisor": {
          "description": "s <= ph / this.",
          "exclusiveMinimum": 0,
          "title": "Perimeterdivisor",
          "type": "number"
        },
        "longitudinalSpacingMax": {
          "description": "Longitudinal bars apart at most [mm].",
          "exclusiveMinimum": 0,
          "title": "Longitudinalspacingmax",
          "type": "number"
        },
        "longitudinalDiaRatio": {
          "description": "Longitudinal bar diameter >= this × s.",
          "exclusiveMinimum": 0,
          "title": "Longitudinaldiaratio",
          "type": "number"
        },
        "longitudinalDiaMin": {
          "description": "[mm]",
          "exclusiveMinimum": 0,
          "title": "Longitudinaldiamin",
          "type": "number"
        },
        "fyMax": {
          "description": "Largest fy, fyt of torsion steel [MPa].",
          "exclusiveMinimum": 0,
          "title": "Fymax",
          "type": "number"
        }
      },
      "required": [
        "theta",
        "aoShare",
        "spacingMax",
        "perimeterDivisor",
        "longitudinalSpacingMax",
        "longitudinalDiaRatio",
        "longitudinalDiaMin",
        "fyMax"
      ],
      "title": "TorsionLimits",
      "type": "object"
    },
    "WallSteel": {
      "additionalProperties": false,
      "description": "Minimum steel and spacing of structural walls.",
      "properties": {
        "rhoSmallBars": {
          "description": "(vertical, horizontal) ρ, small bars.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "exclusiveMaximum": 1,
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "exclusiveMaximum": 1,
              "exclusiveMinimum": 0,
              "type": "number"
            }
          ],
          "title": "Rhosmallbars",
          "type": "array"
        },
        "rhoOtherBars": {
          "description": "(vertical, horizontal) ρ, other bars.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "exclusiveMaximum": 1,
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "exclusiveMaximum": 1,
              "exclusiveMinimum": 0,
              "type": "number"
            }
          ],
          "title": "Rhootherbars",
          "type": "array"
        },
        "smallBarMax": {
          "description": "Largest bar [mm] counted as a small bar.",
          "exclusiveMinimum": 0,
          "title": "Smallbarmax",
          "type": "number"
        },
        "smallBarFy": {
          "description": "Least fy [MPa] of the small-bar ratios.",
          "exclusiveMinimum": 0,
          "title": "Smallbarfy",
          "type": "number"
        },
        "rhoShear": {
          "description": "Least ρ of special walls (both ways).",
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Rhoshear",
          "type": "number"
        },
        "twoLayerThickness": {
          "description": "Thickness [mm] from which two layers apply.",
          "exclusiveMinimum": 0,
          "title": "Twolayerthickness",
          "type": "number"
        },
        "spacingMax": {
          "description": "Largest bar spacing [mm].",
          "exclusiveMinimum": 0,
          "title": "Spacingmax",
          "type": "number"
        }
      },
      "required": [
        "rhoSmallBars",
        "rhoOtherBars",
        "smallBarMax",
        "smallBarFy",
        "rhoShear",
        "twoLayerThickness",
        "spacingMax"
      ],
      "title": "WallSteel",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "source": {
      "default": "",
      "description": "Clause (and page) the table comes from.",
      "title": "Source",
      "type": "string"
    },
    "sources": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Clause references of single entries: {key: clause}.",
      "title": "Sources",
      "type": "object"
    },
    "barDiameters": {
      "$ref": "#/$defs/BarDiameters",
      "description": "Bar size sets [mm] by use."
    },
    "spacingStep": {
      "title": "Spacingstep",
      "type": "number"
    },
    "minSlabSpacing": {
      "title": "Minslabspacing",
      "type": "number"
    },
    "minStirrupSpacing": {
      "title": "Minstirrupspacing",
      "type": "number"
    },
    "columnRho": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Columnrho",
      "type": "array"
    },
    "beamRatioMax": {
      "title": "Beamratiomax",
      "type": "number"
    },
    "slabStrainMin": {
      "title": "Slabstrainmin",
      "type": "number"
    },
    "fytShearMax": {
      "title": "Fytshearmax",
      "type": "number"
    },
    "slendernessLimit": {
      "title": "Slendernesslimit",
      "type": "number"
    },
    "twoWayThickness": {
      "additionalProperties": {
        "maxItems": 3,
        "minItems": 3,
        "prefixItems": [
          {
            "type": "number"
          },
          {
            "type": "number"
          },
          {
            "type": "number"
          }
        ],
        "type": "array"
      },
      "title": "Twowaythickness",
      "type": "object"
    },
    "oneWaySlabThickness": {
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Onewayslabthickness",
      "type": "array"
    },
    "beamThickness": {
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Beamthickness",
      "type": "array"
    },
    "cover": {
      "$ref": "#/$defs/Covers",
      "description": "Assumed covers [mm] by element."
    },
    "crackedStiffness": {
      "$ref": "#/$defs/CrackedStiffness"
    },
    "slender": {
      "$ref": "#/$defs/SlenderLimits"
    },
    "walls": {
      "$ref": "#/$defs/WallSteel"
    },
    "torsion": {
      "anyOf": [
        {
          "$ref": "#/$defs/TorsionLimits"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Torsion design of beams (saengine.design.torsion)."
    },
    "deflection": {
      "anyOf": [
        {
          "$ref": "#/$defs/DeflectionLimitsGroup"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Deflection limits (saengine.design.deflection)."
    }
  },
  "required": [
    "barDiameters",
    "spacingStep",
    "minSlabSpacing",
    "minStirrupSpacing",
    "columnRho",
    "beamRatioMax",
    "slabStrainMin",
    "fytShearMax",
    "slendernessLimit",
    "twoWayThickness",
    "oneWaySlabThickness",
    "beamThickness",
    "cover",
    "crackedStiffness",
    "slender",
    "walls"
  ],
  "title": "ConcreteTable",
  "type": "object",
  "$id": "saengine.codePack.concrete/1"
}
