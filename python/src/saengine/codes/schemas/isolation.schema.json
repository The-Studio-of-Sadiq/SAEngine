    "IsolationProcedure": {
      "additionalProperties": false,
      "description": "Alpha 9 P6: the procedure of the isolation design, by method id.\n\n- ``twoLevel``: the design and the maximum considered earthquake, each with its\n  displacement, forces from the design one (the form of the default pack);\n- ``singleLevel``: one earthquake level (the spectrum × ``spectrum.mceFactor``): the\n  displacement with the lower- and upper-bound properties, Vb = k·D of the governing bound,\n  the unreduced force above Vst = Vb (Ws/W)^(1 − shearExponent·β), Vs = Vst / RI, the\n  vertical distribution with k = distributionFactor·β·Tfb (``dampingPeriod``) or the\n  distribution exponent (``fixed``), the base level's (Vb − Vst)/RI, the device\n  displacements × ``displacementFactor``.",
      "properties": {
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Clause (and page) of this row.",
          "title": "Source"
        },
        "method": {
          "enum": [
            "twoLevel",
            "singleLevel"
          ],
          "title": "Method",
          "type": "string"
        },
        "displacementFactor": {
          "default": 1.0,
          "description": "Factor on the units' displacements for their capacity (γx).",
          "exclusiveMinimum": 0,
          "title": "Displacementfactor",
          "type": "number"
        },
        "shearExponent": {
          "default": 0.0,
          "description": "c of Vst = Vb (Ws/W)^(1 − c·β) (β the effective damping as a fraction).",
          "minimum": 0,
          "title": "Shearexponent",
          "type": "number"
        },
        "distribution": {
          "default": "fixed",
          "description": "Vertical distribution exponent: the table's distribution exponent, or k = distributionFactor·β·Tfb.",
          "enum": [
            "fixed",
            "dampingPeriod"
          ],
          "title": "Distribution",
          "type": "string"
        },
        "distributionFactor": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distributionfactor"
        },
        "baseLevelForce": {
          "default": false,
          "description": "A force (Vb − Vst)/RI at the level just above the isolators.",
          "title": "Baselevelforce",
          "type": "boolean"
        },
        "activationUpperBound": {
          "default": false,
          "description": "The activation force: the greater of the upper-bound value and forces.activationFactor × the nominal one (else the factor × the upper bound), through Vst's formula.",
          "title": "Activationupperbound",
          "type": "boolean"
        },
        "minima": {
          "description": "The lower limits of Vs the pack applies.",
          "items": {
            "enum": [
              "fixedBase",
              "wind",
              "activation"
            ],
            "type": "string"
          },
          "title": "Minima",
          "type": "array"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "method"
      ],
      "title": "IsolationProcedure",
      "type": "object"
    },
