{
  "$defs": {
    "IsolationDampingFormula": {
      "additionalProperties": false,
      "description": "Alpha 9 P6: the damping coefficient by a formula in place of the table: B = 1/η,\nη = √(reference / (offset + ξ)) not below etaMin (ξ in %).",
      "properties": {
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Clause (and page) of this row.",
          "title": "Source"
        },
        "method": {
          "const": "eta",
          "title": "Method",
          "type": "string"
        },
        "reference": {
          "default": 10.0,
          "exclusiveMinimum": 0,
          "title": "Reference",
          "type": "number"
        },
        "offset": {
          "default": 5.0,
          "exclusiveMinimum": 0,
          "title": "Offset",
          "type": "number"
        },
        "etaMin": {
          "default": 0.55,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Etamin",
          "type": "number"
        }
      },
      "required": [
        "method"
      ],
      "title": "IsolationDampingFormula",
      "type": "object"
    },
    "IsolationDampingPoint": {
      "additionalProperties": false,
      "description": "A row of the damping coefficient table: effective damping [% of critical] -> B.",
      "properties": {
