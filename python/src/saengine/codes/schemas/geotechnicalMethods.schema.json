    "BearingRules": {
      "additionalProperties": false,
      "description": "Bearing resistance by the general equation on effective dimensions (method\n``effectiveArea``).",
      "properties": {
        "method": {
          "const": "effectiveArea",
          "default": "effectiveArea",
          "title": "Method",
          "type": "string"
        },
        "nGammaFactor": {
          "description": "Nγ = factor (Nq - 1) tan φ'.",
          "exclusiveMinimum": 0,
          "title": "Ngammafactor",
          "type": "number"
        },
        "gammaShape": {
          "description": "sγ = 1 - c B'/L'.",
          "exclusiveMinimum": 0,
          "title": "Gammashape",
          "type": "number"
        },
        "undrainedShape": {
          "description": "sc = 1 + c B'/L' (undrained).",
          "exclusiveMinimum": 0,
          "title": "Undrainedshape",
          "type": "number"
        }
      },
      "required": [
        "nGammaFactor",
        "gammaShape",
        "undrainedShape"
      ],
      "title": "BearingRules",
      "type": "object"
    },
    "CorrelationFactors": {
      "additionalProperties": false,
