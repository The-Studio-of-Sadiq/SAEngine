        "loadTests": {
          "description": "(n, ξ1, ξ2).",
          "items": {
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [
              {
                "exclusiveMinimum": 0,
                "type": "number"
              },
              {
                "exclusiveMinimum": 0,
                "type": "number"
              },
              {
                "exclusiveMinimum": 0,
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Loadtests",
          "type": "array"
        },
        "groundTests": {
          "description": "(n, ξ3, ξ4).",
          "items": {
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [
              {
                "exclusiveMinimum": 0,
                "type": "number"
              },
              {
                "exclusiveMinimum": 0,
                "type": "number"
              },
              {
                "exclusiveMinimum": 0,
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Groundtests",
          "type": "array"
