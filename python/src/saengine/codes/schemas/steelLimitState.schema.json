          "title": "Gammam0",
          "type": "number"
        },
        "gammaM1": {
          "description": "γm1: resistance governed by the ultimate stress.",
          "exclusiveMinimum": 0,
          "title": "Gammam1",
          "type": "number"
        },
        "gammaMb": {
          "description": "γmb: bolts of bearing type connections.",
          "exclusiveMinimum": 0,
          "title": "Gammamb",
          "type": "number"
        },
        "gammaMf": {
          "description": "γmf: slip of friction grip bolts at the ultimate load.",
          "exclusiveMinimum": 0,
          "title": "Gammamf",
          "type": "number"
        },
        "gammaMfService": {
          "description": "γmf: slip designed at the service load.",
          "exclusiveMinimum": 0,
          "title": "Gammamfservice",
          "type": "number"
        },
        "gammaMw": {
          "description": "γmw: welds, shop fabrication.",
          "exclusiveMinimum": 0,
          "title": "Gammamw",
          "type": "number"
        },
        "gammaMwField": {
          "description": "γmw: welds, field fabrication.",
          "exclusiveMinimum": 0,
          "title": "Gammamwfield",
          "type": "number"
        }
      },
      "required": [
        "gammaM0",
        "gammaM1",
        "gammaMb",
        "gammaMf",
        "gammaMfService",
        "gammaMw",
        "gammaMwField"
      ],
      "title": "SteelPartialFactors",
      "type": "object"
    },
    "SteelSeismicRules": {
      "additionalProperties": false,
