{
  "$defs": {
    "AreaUse": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Clause (and page) of this row.",
          "title": "Source"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "live": {
          "description": "Minimum uniformly distributed live load [kN/m²].",
          "minimum": 0,
          "title": "Live",
          "type": "number"
        },
        "concentrated": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Minimum concentrated live load [kN], applied alone (not with the uniform load) on the patch ``patch``; empty: none.",
          "title": "Concentrated"
        },
        "patch": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Side of the square the concentrated load acts on [mm]; empty: the table's ``concentratedPatch``.",
          "title": "Patch"
        },
        "reducible": {
          "default": true,
          "description": "False: the uniform load is never reduced (a nonreducible row).",
          "title": "Reducible",
          "type": "boolean"
        },
        "roof": {
          "default": false,
          "description": "A roof live load (case Lr): reduced by the roof rule, not the floor rule.",
          "title": "Roof",
          "type": "boolean"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The row's notes, for the user.",
          "title": "Note"
        }
      },
      "required": [
        "name",
        "live"
      ],
      "title": "AreaUse",
      "type": "object"
    },
    "BarrierLoads": {
