    "ComponentForceRule": {
      "additionalProperties": false,
      "description": "The seismic design force of a component, by a method the engine names\n(:mod:`saengine.design.nonstructural`). ``amplifiedHeight``: F = αc·a·Wc·Ic/Rc ×\n(1 + heightFactor·z/h), minFactor·a·Wc·Ic ≤ F ≤ maxFactor·a·Wc·Ic, with a = groundFactor·Z·S\n(Z the zone coefficient, S the site factor of the seismic table); vertical ± verticalFactor·a·Wc.",
      "properties": {
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Clause (and page) of this row.",
          "title": "Source"
        },
        "method": {
          "const": "amplifiedHeight",
          "default": "amplifiedHeight",
          "title": "Method",
          "type": "string"
        },
        "groundFactor": {
          "description": "a = this × Z × S [g].",
          "exclusiveMinimum": 0,
          "title": "Groundfactor",
          "type": "number"
        },
        "heightFactor": {
          "description": "Of z/h in (1 + this·z/h).",
          "minimum": 0,
          "title": "Heightfactor",
          "type": "number"
        },
        "minFactor": {
          "description": "Least F over a·Wc·Ic.",
          "minimum": 0,
          "title": "Minfactor",
          "type": "number"
        },
        "maxFactor": {
          "description": "Largest F over a·Wc·Ic.",
          "exclusiveMinimum": 0,
          "title": "Maxfactor",
          "type": "number"
        },
        "verticalFactor": {
          "description": "Concurrent vertical force over a·Wc.",
          "minimum": 0,
          "title": "Verticalfactor",
          "type": "number"
        },
        "zOverHMax": {
          "default": 1.0,
          "description": "Upper limit of z/h.",
          "exclusiveMinimum": 0,
          "title": "Zoverhmax",
          "type": "number"
        },
        "symbols": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "The code's symbols (force, amplification, ...).",
          "title": "Symbols",
          "type": "object"
        },
        "equation": {
          "default": "",
          "description": "The code's equation number.",
          "title": "Equation",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
