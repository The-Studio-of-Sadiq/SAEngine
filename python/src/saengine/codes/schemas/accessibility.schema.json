  "additionalProperties": false,
  "description": "Ramps: what counts as one, and the rules of each kind (walkway, accessible, exit,\nvehicle, parking). A kind the pack leaves out is not covered by it.",
  "properties": {
    "source": {
      "default": "",
      "description": "Clause (and page) the table comes from.",
      "title": "Source",
      "type": "string"
    },
    "sources": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Clause references of single entries: {key: clause}.",
      "title": "Sources",
      "type": "object"
    },
    "clauses": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Short clause references the results cite, by key, without the code's name (e.g. 'Part 6 Sec 2.5.7.3'); read by saengine.codes.context.cite. A key the pack does not give is not cited.",
      "title": "Clauses",
      "type": "object"
    },
    "rampThreshold": {
      "$ref": "#/$defs/RampSlope",
      "description": "A sloping walking surface is a ramp when steeper than 1 in this."
    },
    "ramps": {
      "additionalProperties": {
        "$ref": "#/$defs/RampRules"
      },
      "description": "Rules by kind of ramp (the architecture's Ramp.kind).",
      "title": "Ramps",
      "type": "object"
    }
  },
  "required": [
    "rampThreshold"
  ],
  "title": "AccessibilityTable",
  "type": "object",
  "$id": "saengine.codePack.accessibility/1"
}
