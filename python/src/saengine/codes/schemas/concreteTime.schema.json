    "CreepAci209": {
      "additionalProperties": false,
      "description": "Method ``aci209`` (ACI 209R-92 Eqs 2-8, 2-11 and the correction factors of Sec 2.5):\nφ(t, t0) = (t - t0)^ψ / (d + (t - t0)^ψ) φu, φu = ultimate × γla γλ γvs × other, with\nγla = loadingAge[0] t0^loadingAge[1] (moist cured), γλ = humidity[0] - humidity[1] h (h the\nrelative humidity as a decimal, at least humidityMin), γvs = volumeSurface[0] (1 +\nvolumeSurface[1] exp(-volumeSurface[2] V/S)), V/S [mm] half the effective thickness.\nRelative to the modulus at the age of loading.",
      "properties": {
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Clause (and page) of this row.",
          "title": "Source"
        },
        "method": {
          "const": "aci209",
          "description": "Method id.",
          "title": "Method",
          "type": "string"
        },
        "ultimate": {
          "description": "Ultimate creep coefficient at standard conditions.",
          "exclusiveMinimum": 0,
          "title": "Ultimate",
          "type": "number"
        },
        "timeExponent": {
          "description": "ψ of the time function.",
          "exclusiveMinimum": 0,
          "title": "Timeexponent",
          "type": "number"
        },
        "timeConstant": {
          "description": "d [days] of the time function.",
          "exclusiveMinimum": 0,
          "title": "Timeconstant",
          "type": "number"
        },
        "loadingAge": {
          "description": "(a, b) of γla = a t0^b.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Loadingage",
          "type": "array"
        },
        "humidity": {
          "description": "(a, b) of γλ = a - b h.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Humidity",
          "type": "array"
        },
        "humidityMin": {
          "description": "Least relative humidity [%] the factor is for.",
          "exclusiveMinimum": 0,
          "title": "Humiditymin",
          "type": "number"
        },
        "volumeSurface": {
          "description": "(a, b, c) of γvs = a (1 + b exp(-c V/S)), V/S in mm.",
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Volumesurface",
          "type": "array"
        },
        "otherFactor": {
          "default": 1.0,
          "description": "Product of the slump, fines and air factors (1 at standard).",
          "exclusiveMinimum": 0,
          "title": "Otherfactor",
          "type": "number"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "method",
        "ultimate",
        "timeExponent",
        "timeConstant",
        "loadingAge",
        "humidity",
        "humidityMin",
        "volumeSurface"
      ],
      "title": "CreepAci209",
      "type": "object"
    },
