{
  "$defs": {
    "LinearInStrength": {
      "additionalProperties": false,
      "description": "Alpha 9 C18: a factor linear in f'c within bounds: min(max(base + slope f'c, least),\nmost).",
      "properties": {
        "base": {
          "title": "Base",
          "type": "number"
        },
        "slope": {
          "default": 0.0,
          "title": "Slope",
          "type": "number"
        },
        "least": {
          "exclusiveMinimum": 0,
          "title": "Least",
          "type": "number"
        },
        "most": {
          "exclusiveMinimum": 0,
          "title": "Most",
          "type": "number"
        }
      },
      "required": [
        "base",
        "least",
        "most"
      ],
      "title": "LinearInStrength",
      "type": "object"
    },
    "RebarGrade": {
      "additionalProperties": false,
      "description": "A reinforcement grade of a pack's bar standard (ASTM A615 Grade 60).",
      "properties": {
        "id": {
          "description": "The material id (\"A615-60\").",
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "description": "\"ASTM A615 Grade 60\".",
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "fy": {
          "description": "Specified yield strength [MPa].",
          "exclusiveMinimum": 0,
          "title": "Fy",
          "type": "number"
        },
        "standard": {
          "default": "",
          "description": "The bar standard (\"ASTM A615/A615M\").",
          "title": "Standard",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "fy"
      ],
      "title": "RebarGrade",
      "type": "object"
    },
    "StressBlockRule": {
      "additionalProperties": false,
      "description": "Alpha 9 C18: the rectangular stress block of the strength design by f'c (AS 3600 8.1.3,\nNZS 3101 7.4.2.7 type): the stress ``alpha`` f'c over the depth ``gamma`` c, and the squash\nload P0 = ``squash`` f'c (Ag - Ast) + fy Ast (empty: ``alpha``). A pack without it keeps\nACI 318's 0.85 f'c over β1 c (:mod:`saengine.design.rc`).",
      "properties": {
        "alpha": {
          "$ref": "#/$defs/LinearInStrength"
        },
        "gamma": {
          "$ref": "#/$defs/LinearInStrength"
        },
        "squash": {
          "anyOf": [
            {
              "$ref": "#/$defs/LinearInStrength"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "clause": {
          "default": "",
          "title": "Clause",
          "type": "string"
        }
      },
      "required": [
        "alpha",
        "gamma"
      ],
      "title": "StressBlockRule",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "source": {
      "default": "",
      "description": "Clause (and page) the table comes from.",
      "title": "Source",
      "type": "string"
    },
    "sources": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Clause references of single entries: {key: clause}.",
