      "title": "Damping",
      "type": "object"
    },
    "acceptance": {
      "enum": [
        "occupancyLimits",
        "frequencyCurve"
      ],
      "title": "Acceptance",
      "type": "string"
    },
    "limits": {
      "additionalProperties": {
        "exclusiveMinimum": 0,
        "type": "number"
      },
      "description": "occupancyLimits: occupancy -> peak [milli-g].",
      "title": "Limits",
      "type": "object"
    },
    "curves": {
