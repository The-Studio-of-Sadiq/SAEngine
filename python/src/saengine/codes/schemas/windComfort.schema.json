      "title": "Areauses",
      "type": "object"
    },
    "defaultOccupancy": {
      "title": "Defaultoccupancy",
      "type": "string"
    }
  },
  "required": [
    "response",
    "returnPeriod",
    "referencePeriod",
    "speedRatio",
