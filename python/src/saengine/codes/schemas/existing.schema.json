            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "aci440: k of f'cc.",
          "title": "Strength"
        },
        "minRatio": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "aci440: fl/f'c below this: no confinement counted.",
          "title": "Minratio"
        },
        "strainBase": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "aci440: a of εccu.",
          "title": "Strainbase"
        },
        "strainCoefficient": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "aci440: b of εccu.",
          "title": "Straincoefficient"
        },
        "strainExponent": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "aci440: e of εccu.",
          "title": "Strainexponent"
        },
        "strainCap": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "aci440: largest εccu.",
          "title": "Straincap"
        },
        "peakStrain": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "aci440: εc' of unconfined concrete.",
          "title": "Peakstrain"
        },
        "rotationFactor": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "en1998: α of the term in the exponent of θum.",
          "title": "Rotationfactor"
        }
      },
      "required": [
        "strainShare"
      ],
      "title": "FrpConfinement",
      "type": "object"
    },
    "FrpFlexure": {
      "additionalProperties": false,
      "description": "FRP flexural strengthening: the laminate's strain at most the debonding strain\nεfd = k·√(f'c/(n·Ef·tf)) ≤ share·εfu, its force times ψf.",
