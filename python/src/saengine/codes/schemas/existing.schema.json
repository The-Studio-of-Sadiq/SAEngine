    "FrpConfinement": {
      "additionalProperties": false,
      "description": "FRP wraps confining a column. aci440: fl = 2·Ef·n·tf·εfe/D, f'cc = f'c + ψf·k·κa·fl,\nεccu = εc'·(a + b·κb·(fl/f'c)·(εfe/εc')^e) ≤ strainCap, εfe = κε·εfu; en1998: the term\nα·ρf·ff,e/fc added to the confinement exponent of θum, ff,e = Ef·κε·εfu.",
      "properties": {
        "strainShare": {
          "description": "κε: εfe = κε·εfu.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Strainshare",
          "type": "number"
        },
        "psi": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "aci440: ψf of the confinement.",
          "title": "Psi"
        },
        "strength": {
