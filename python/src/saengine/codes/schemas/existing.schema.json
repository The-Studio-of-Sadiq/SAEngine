{
  "$defs": {
    "C1C2Band": {
      "additionalProperties": false,
      "description": "C1·C2 of the linear procedure for periods up to ``periodTo``: ``values`` [[m from, C1·C2],\n...] by the largest m-factor of the members, in rising order.",
      "properties": {
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Clause (and page) of this row.",
          "title": "Source"
        },
        "periodTo": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "[s]; empty: any longer period.",
          "title": "Periodto"
        },
        "values": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "exclusiveMinimum": 0,
                "type": "number"
              }
            ],
            "type": "array"
          },
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "values"
      ],
      "title": "C1C2Band",
      "type": "object"
    },
    "ChordRotationCapacity": {
      "additionalProperties": false,
      "description": "Model ``chordRotationCapacity``: the ultimate chord rotation of an RC member by an\nempirical formula θum = (1/γel)·k·c^ν·[max(ωmin, ω')/max(ωmin, ω)·fc]^e1·(LV/h)^e2·\nbase^(α·ρsx·fyw/fc)·diag^(100·ρd) (fc in MPa), × ``wallFactor`` for walls; the levels are\n``yieldLevel`` (θ ≤ θy, the chord rotation at the first yield of the bars) and shares of\nθum.",
      "properties": {
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Clause (and page) of this row.",
          "title": "Source"
        },
        "gammaEl": {
          "exclusiveMinimum": 0,
          "title": "Gammael",
          "type": "number"
        },
        "k": {
          "exclusiveMinimum": 0,
          "title": "K",
          "type": "number"
        },
        "axialBase": {
          "exclusiveMinimum": 0,
          "title": "Axialbase",
          "type": "number"
        },
        "omegaMin": {
          "exclusiveMinimum": 0,
          "title": "Omegamin",
          "type": "number"
        },
        "omegaExponent": {
          "title": "Omegaexponent",
          "type": "number"
        },
        "spanExponent": {
          "title": "Spanexponent",
          "type": "number"
        },
        "confinementBase": {
          "exclusiveMinimum": 0,
          "title": "Confinementbase",
          "type": "number"
        },
        "diagonalBase": {
          "exclusiveMinimum": 0,
          "title": "Diagonalbase",
          "type": "number"
        },
        "wallFactor": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Wallfactor",
          "type": "number"
        },
        "yieldLevel": {
          "description": "The level met while θ ≤ θy.",
          "title": "Yieldlevel",
          "type": "string"
        },
        "shares": {
          "additionalProperties": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "description": "Other levels: their limit as a share of θum.",
          "title": "Shares",
          "type": "object"
        }
      },
      "required": [
        "gammaEl",
        "k",
        "axialBase",
        "omegaMin",
        "omegaExponent",
        "spanExponent",
        "confinementBase",
        "diagonalBase",
