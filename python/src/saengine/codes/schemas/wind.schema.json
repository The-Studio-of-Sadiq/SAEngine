{
  "$defs": {
    "ArchRow": {
      "additionalProperties": false,
      "description": "A rise-to-span range of an arched roof: windward quarter Cp = a·r + b (and the alternate\ncoefficient that shall also be used, where given).",
      "properties": {
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Clause (and page) of this row.",
          "title": "Source"
        },
        "elevated": {
          "description": "Roof on an elevated structure (else from the ground).",
          "title": "Elevated",
          "type": "boolean"
        },
        "riseFrom": {
          "minimum": 0,
          "title": "Risefrom",
          "type": "number"
        },
        "riseTo": {
          "exclusiveMinimum": 0,
          "title": "Riseto",
          "type": "number"
        },
        "windward": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Windward",
          "type": "array"
        },
        "alternate": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alternate"
        }
      },
      "required": [
        "elevated",
        "riseFrom",
        "riseTo",
        "windward"
      ],
      "title": "ArchRow",
      "type": "object"
    },
    "ArchedTable": {
      "additionalProperties": false,
      "description": "Arched roofs: windward quarter by r, centre half Cp = a·r + b, leeward quarter Cp.",
