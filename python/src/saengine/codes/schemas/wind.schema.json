    "CladdingTable": {
      "additionalProperties": false,
      "description": "Components and cladding (BNBC 2020 Part 6 Sec 2.4.11.5): the (GCp) curves of walls and\nflat roofs (θ ≤ 10°) of low-rise (h ≤ ``lowRiseHeight``) and taller buildings, the internal\npressure coefficients and the edge-zone width a.",
      "properties": {
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Clause (and page) of this row.",
          "title": "Source"
        },
        "lowRiseHeight": {
          "description": "h [m] up to which the low-rise curves hold.",
          "exclusiveMinimum": 0,
          "title": "Lowriseheight",
          "type": "number"
        },
        "lowRise": {
          "items": {
            "$ref": "#/$defs/CladdingCurve"
          },
          "title": "Lowrise",
          "type": "array"
        },
        "highRise": {
          "items": {
            "$ref": "#/$defs/CladdingCurve"
          },
          "title": "Highrise",
          "type": "array"
        },
        "lowRiseWallFactor": {
          "description": "Factor on the low-rise wall (GCp) for a roof θ ≤ 10°.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Lowrisewallfactor",
          "type": "number"
        },
        "internal": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "(GCpi) magnitude by enclosure; None: the wind table's internalPressure.",
          "title": "Internal"
        },
        "edgeFraction": {
          "description": "a ≤ edgeFraction · least plan dimension.",
          "exclusiveMinimum": 0,
          "title": "Edgefraction",
          "type": "number"
        },
        "edgeHeightFraction": {
          "description": "Low-rise: a ≤ this · h.",
          "exclusiveMinimum": 0,
          "title": "Edgeheightfraction",
          "type": "number"
        },
        "edgeMinFraction": {
          "description": "a ≥ this · least plan dimension.",
          "exclusiveMinimum": 0,
          "title": "Edgeminfraction",
          "type": "number"
        },
        "edgeMin": {
          "description": "a ≥ this [m].",
          "exclusiveMinimum": 0,
          "title": "Edgemin",
          "type": "number"
        },
        "parapetCorner": {
          "description": "A parapet this high [m] or more turns roof zone 3 into zone 2.",
          "exclusiveMinimum": 0,
          "title": "Parapetcorner",
          "type": "number"
        }
      },
      "required": [
        "lowRiseHeight",
        "lowRise",
        "highRise",
        "lowRiseWallFactor",
        "edgeFraction",
        "edgeHeightFraction",
        "edgeMinFraction",
        "edgeMin",
        "parapetCorner"
      ],
      "title": "CladdingTable",
      "type": "object"
    },
