    "FlexibleGustRow": {
      "additionalProperties": false,
      "description": "The gust-effect factor Gf of a flexible or dynamically sensitive building (BNBC 2020 Part 6\nSec 2.4.8.2): read by :func:`saengine.fem.loads.flexible_gust_factor`.",
