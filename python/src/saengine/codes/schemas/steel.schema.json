{
  "$defs": {
    "PondingCurve": {
      "additionalProperties": false,
      "properties": {
        "param": {
          "description": "The curve's flexibility constant (Cs or Cp).",
          "minimum": 0,
          "title": "Param",
          "type": "number"
        },
        "points": {
          "description": "[stress index U, upper limit of the other flexibility constant] pairs.",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Points",
          "type": "array"
        }
      },
      "required": [
        "param",
        "points"
      ],
      "title": "PondingCurve",
      "type": "object"
    },
    "SteelBars": {
      "additionalProperties": false,
      "description": "Rectangular bars and rounds in flexure.",
      "properties": {
        "plasticCap": {
          "description": "Mp at most this × My.",
          "exclusiveMinimum": 0,
          "title": "Plasticcap",
          "type": "number"
        },
        "yieldLimit": {
          "description": "Lb d / t² <= this E / Fy: yielding only.",
          "exclusiveMinimum": 0,
          "title": "Yieldlimit",
          "type": "number"
        },
        "ltbLimit": {
          "description": "... <= this E / Fy: inelastic LTB, else elastic.",
          "exclusiveMinimum": 0,
          "title": "Ltblimit",
          "type": "number"
        },
        "ltbA": {
          "description": "Mn = Cb (ltbA - ltbB (Lb d / t²) Fy / E) My.",
          "exclusiveMinimum": 0,
          "title": "Ltba",
          "type": "number"
        },
        "ltbB": {
          "description": "See ``ltbA``.",
          "exclusiveMinimum": 0,
          "title": "Ltbb",
          "type": "number"
        },
        "elastic": {
          "description": "Fcr = this E Cb / (Lb d / t²).",
          "exclusiveMinimum": 0,
          "title": "Elastic",
          "type": "number"
        }
      },
      "required": [
        "plasticCap",
        "yieldLimit",
        "ltbLimit",
        "ltbA",
        "ltbB",
        "elastic"
      ],
      "title": "SteelBars",
      "type": "object"
    },
    "SteelBoltGrade": {
      "additionalProperties": false,
      "description": "Nominal stresses of a bolt grade or a threaded part [MPa]: fixed values, or shares of the\npart's Fu (threaded parts).",
      "properties": {
        "Fnt": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Nominal tensile stress [MPa].",
          "title": "Fnt"
        },
        "Fnv": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Nominal shear stress, bearing-type [MPa].",
          "title": "Fnv"
        },
        "FntOfFu": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fnt as a share of Fu.",
          "title": "Fntoffu"
        },
        "FnvOfFu": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fnv as a share of Fu.",
          "title": "Fnvoffu"
        },
        "pretension": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Key of ``pretension`` (the bolt family); none: not pretensioned.",
          "title": "Pretension"
        }
      },
      "title": "SteelBoltGrade",
      "type": "object"
    },
    "SteelBracing": {
      "additionalProperties": false,
      "description": "Stability bracing of columns and beams (K = 1 between the braces).",
      "properties": {
        "phi": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Phi",
          "type": "number"
        },
        "columnRelative": {
          "$ref": "#/$defs/SteelBracingRow"
        },
        "columnNodal": {
          "$ref": "#/$defs/SteelBracingRow"
        },
        "beamRelative": {
          "$ref": "#/$defs/SteelBracingRow"
        },
        "beamNodal": {
          "$ref": "#/$defs/SteelBracingRow"
        },
        "torsionalMoment": {
          "description": "Mbr = this × Mr L / (n Cb Lb).",
          "exclusiveMinimum": 0,
          "title": "Torsionalmoment",
          "type": "number"
        },
        "torsionalStiffness": {
          "description": "βT = this × L Mr² / (n E Iy Cb²) / φ.",
          "exclusiveMinimum": 0,
          "title": "Torsionalstiffness",
          "type": "number"
        },
        "distortional": {
          "description": "βsec = this × E / ho × (...).",
          "exclusiveMinimum": 0,
          "title": "Distortional",
          "type": "number"
        },
        "slenderness": {
          "description": "L/r limit of stability bracing.",
          "exclusiveMinimum": 0,
          "title": "Slenderness",
          "type": "number"
        }
      },
      "required": [
        "phi",
        "columnRelative",
        "columnNodal",
        "beamRelative",
        "beamNodal",
        "torsionalMoment",
        "torsionalStiffness",
        "distortional",
        "slenderness"
      ],
      "title": "SteelBracing",
      "type": "object"
    },
    "SteelBracingRow": {
      "additionalProperties": false,
      "description": "Required brace strength Pbr = strength × Pr (columns) or × Mr Cd / ho (beams), stiffness\nβbr = stiffness × Pr / Lb (or × Mr Cd / (Lb ho)) / φ.",
      "properties": {
        "strength": {
          "exclusiveMinimum": 0,
          "title": "Strength",
          "type": "number"
        },
        "stiffness": {
          "exclusiveMinimum": 0,
          "title": "Stiffness",
          "type": "number"
        }
      },
      "required": [
        "strength",
        "stiffness"
      ],
      "title": "SteelBracingRow",
      "type": "object"
    },
    "SteelBuiltUp": {
      "additionalProperties": false,
      "description": "Built-up compression members: modified slenderness and dimensional limits.",
      "properties": {
        "welded": {
          "description": "Welded / pretensioned connectors: this α²/(1+α²).",
          "exclusiveMinimum": 0,
          "title": "Welded",
          "type": "number"
        },
        "componentShare": {
          "description": "K a / ri at most this × the member's KL/r.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Componentshare",
          "type": "number"
        },
        "componentK": {
          "description": "K of a component between connectors.",
          "exclusiveMinimum": 0,
          "title": "Componentk",
          "type": "number"
        },
        "plateSpacing": {
          "description": "Outside plate: spacing <= this √(E/Fy) t ...",
          "exclusiveMinimum": 0,
          "title": "Platespacing",
          "type": "number"
        },
        "plateSpacingMax": {
          "description": "... and at most this [mm].",
          "exclusiveMinimum": 0,
          "title": "Platespacingmax",
          "type": "number"
        },
        "plateStaggered": {
          "description": "Staggered fasteners: <= this √(E/Fy) t ...",
          "exclusiveMinimum": 0,
          "title": "Platestaggered",
          "type": "number"
        },
        "plateStaggeredMax": {
          "description": "... and at most this [mm].",
          "exclusiveMinimum": 0,
          "title": "Platestaggeredmax",
          "type": "number"
        },
        "lacingSingle": {
          "description": "L/r of single lacing bars at most this.",
          "exclusiveMinimum": 0,
          "title": "Lacingsingle",
          "type": "number"
        },
        "lacingDouble": {
          "description": "L/r of double lacing bars at most this.",
          "exclusiveMinimum": 0,
          "title": "Lacingdouble",
          "type": "number"
        },
        "lacingShear": {
          "description": "Lacing shear: this × φc Pn of the member.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Lacingshear",
          "type": "number"
        },
        "lacingDoubleLength": {
          "description": "Double lacing: L = this × the bar length.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Lacingdoublelength",
          "type": "number"
        },
        "tiePlateEnd": {
          "description": "End tie plate length >= this × line distance.",
          "exclusiveMinimum": 0,
          "title": "Tieplateend",
          "type": "number"
        },
        "tiePlateIntermediate": {
          "description": "Intermediate: >= this × the distance.",
          "exclusiveMinimum": 0,
          "title": "Tieplateintermediate",
          "type": "number"
        },
        "tiePlateThickness": {
          "description": "Tie plate t >= this × the line distance.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Tieplatethickness",
          "type": "number"
        }
      },
      "required": [
        "welded",
        "componentShare",
        "componentK",
        "plateSpacing",
        "plateSpacingMax",
        "plateStaggered",
        "plateStaggeredMax",
        "lacingSingle",
        "lacingDouble",
        "lacingShear",
        "lacingDoubleLength",
        "tiePlateEnd",
        "tiePlateIntermediate",
        "tiePlateThickness"
      ],
      "title": "SteelBuiltUp",
      "type": "object"
    },
    "SteelConnectionData": {
      "additionalProperties": false,
      "description": "Bolts, holes, edges and fillet welds of steel connections.",
      "properties": {
        "boltGrades": {
          "additionalProperties": {
            "$ref": "#/$defs/SteelBoltGrade"
          },
          "title": "Boltgrades",
          "type": "object"
        },
        "boltAliases": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Other grade names taken as a grade of ``boltGrades`` (labelled in ``sources.boltAliases``).",
          "title": "Boltaliases",
          "type": "object"
        },
        "pretension": {
          "additionalProperties": {
            "additionalProperties": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "type": "object"
          },
          "description": "Minimum bolt pretension Tb [kN] by bolt family and diameter [mm].",
          "title": "Pretension",
          "type": "object"
        },
        "slip": {
          "$ref": "#/$defs/SteelSlip"
        },
        "holes": {
          "additionalProperties": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "description": "Standard hole diameter [mm] by bolt diameter.",
          "title": "Holes",
          "type": "object"
        },
        "holeOver": {
          "description": "Larger bolts: standard hole d + this [mm].",
          "exclusiveMinimum": 0,
          "title": "Holeover",
          "type": "number"
        },
        "netHoleAllowance": {
          "description": "Hole width + this for net areas [mm].",
          "minimum": 0,
          "title": "Netholeallowance",
          "type": "number"
        },
        "edgeRolled": {
          "additionalProperties": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "description": "Minimum edge distance, rolled [mm].",
          "title": "Edgerolled",
          "type": "object"
        },
        "edgeSheared": {
          "additionalProperties": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "description": "Minimum edge distance, sheared [mm].",
          "title": "Edgesheared",
          "type": "object"
        },
        "edgeOverRolled": {
          "description": "Larger bolts, rolled edges: this × d.",
          "exclusiveMinimum": 0,
          "title": "Edgeoverrolled",
          "type": "number"
        },
        "edgeOverSheared": {
          "description": "Larger bolts, sheared edges: this × d.",
          "exclusiveMinimum": 0,
          "title": "Edgeoversheared",
          "type": "number"
        },
        "minSpacing": {
          "description": "Least bolt spacing as a multiple of d.",
          "exclusiveMinimum": 0,
          "title": "Minspacing",
          "type": "number"
        },
        "maxEdgeThickness": {
          "description": "Largest edge distance: this × t ...",
          "exclusiveMinimum": 0,
          "title": "Maxedgethickness",
          "type": "number"
        },
        "maxEdge": {
          "description": "... and at most this [mm].",
          "exclusiveMinimum": 0,
          "title": "Maxedge",
          "type": "number"
        },
        "longJointLength": {
          "description": "Tension splices: bolt pattern longer than this [mm] ...",
          "exclusiveMinimum": 0,
          "title": "Longjointlength",
          "type": "number"
        },
        "longJointFactor": {
          "description": "... has Fnv times this.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Longjointfactor",
          "type": "number"
        },
        "filletMin": {
          "description": "Minimum fillet weld leg by the thinner part: [[t up to (null: above), leg [mm]], ...].",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              {
                "exclusiveMinimum": 0,
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Filletmin",
          "type": "array"
        },
        "filletMaxThin": {
          "description": "Along edges thinner than this, the leg is at most the thickness [mm] ...",
          "exclusiveMinimum": 0,
          "title": "Filletmaxthin",
          "type": "number"
        },
        "filletMaxReduce": {
          "description": "... else the thickness less this [mm].",
          "minimum": 0,
          "title": "Filletmaxreduce",
          "type": "number"
        },
        "concreteBearingFull": {
          "description": "Pp / (f'c A1) on the full concrete area.",
          "exclusiveMinimum": 0,
          "title": "Concretebearingfull",
          "type": "number"
        },
        "concreteBearingPartial": {
          "description": "Pp / (f'c A1 √(A2/A1)) on part of the concrete area ...",
          "exclusiveMinimum": 0,
          "title": "Concretebearingpartial",
          "type": "number"
        },
        "concreteBearingMax": {
          "description": "... and Pp / (f'c A1) at most this.",
          "exclusiveMinimum": 0,
          "title": "Concretebearingmax",
          "type": "number"
        },
        "methods": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Method ids where the code gives a requirement but no method (e.g. ``prying``: ``tStub``); a missing key: the check is not made.",
          "title": "Methods",
          "type": "object"
        }
      },
      "required": [
        "boltGrades",
        "pretension",
        "slip",
        "holes",
        "holeOver",
        "netHoleAllowance",
        "edgeRolled",
        "edgeSheared",
        "edgeOverRolled",
        "edgeOverSheared",
        "minSpacing",
        "maxEdgeThickness",
        "maxEdge",
        "longJointLength",
        "longJointFactor",
        "filletMin",
        "filletMaxThin",
        "filletMaxReduce",
        "concreteBearingFull",
        "concreteBearingPartial",
        "concreteBearingMax"
      ],
      "title": "SteelConnectionData",
      "type": "object"
    },
    "SteelMembers": {
      "additionalProperties": false,
      "description": "B31: the member limit states beyond Secs 10.4-10.8.1, with their clause strings.",
      "properties": {
        "torsion": {
          "$ref": "#/$defs/SteelTorsion"
        },
        "builtUp": {
          "$ref": "#/$defs/SteelBuiltUp"
        },
        "bars": {
          "$ref": "#/$defs/SteelBars"
        },
        "tensionField": {
          "$ref": "#/$defs/SteelTensionField"
        },
        "clauses": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Clause references of the results, by key.",
          "title": "Clauses",
          "type": "object"
        }
      },
      "required": [
        "torsion",
        "builtUp",
        "bars",
        "tensionField"
      ],
      "title": "SteelMembers",
      "type": "object"
    },
    "SteelPhi": {
      "additionalProperties": {
        "exclusiveMinimum": 0,
        "maximum": 1,
        "type": "number"
      },
      "description": "φ of structural steel (extra keys allowed for hooks, also 0 < φ <= 1).",
      "properties": {
        "tensionYield": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Tensionyield",
          "type": "number"
        },
        "tensionRupture": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Tensionrupture",
          "type": "number"
        },
        "compression": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Compression",
          "type": "number"
        },
        "flexure": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Flexure",
          "type": "number"
        },
        "shear": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Shear",
          "type": "number"
        },
        "bolt": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Bolt",
          "type": "number"
        },
        "bearing": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Bearing",
          "type": "number"
        },
        "blockShear": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Blockshear",
          "type": "number"
        },
        "weld": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Weld",
          "type": "number"
        },
        "plateFlexure": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Plateflexure",
          "type": "number"
        }
      },
      "required": [
        "tensionYield",
        "tensionRupture",
        "compression",
        "flexure",
        "shear",
        "bolt",
        "bearing",
        "blockShear",
        "weld",
        "plateFlexure"
      ],
      "title": "SteelPhi",
      "type": "object"
    },
    "SteelPonding": {
      "additionalProperties": false,
      "description": "Roof ponding: the simplified stiffness limits and the digitised limit curves.",
      "properties": {
        "limit": {
          "description": "Cp + secondary × Cs at most this.",
          "exclusiveMinimum": 0,
          "title": "Limit",
          "type": "number"
        },
        "secondary": {
          "description": "Factor on Cs.",
          "exclusiveMinimum": 0,
          "title": "Secondary",
          "type": "number"
        },
        "coefficient": {
          "description": "C = this × Ls Lp⁴ / Ip (m, mm⁴).",
          "exclusiveMinimum": 0,
          "title": "Coefficient",
          "type": "number"
        },
        "deck": {
          "description": "Id at least this × S⁴ (mm⁴/m, m).",
          "exclusiveMinimum": 0,
          "title": "Deck",
          "type": "number"
        },
        "trussFactor": {
          "description": "Is of trusses and steel joists taken times this.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Trussfactor",
          "type": "number"
        },
        "stressLimit": {
          "description": "U = (this × Fy - fo) / fo.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Stresslimit",
          "type": "number"
        },
        "primary": {
          "description": "Limiting Cp by Up, one curve per Cs (the primary-system figure).",
          "items": {
            "$ref": "#/$defs/PondingCurve"
          },
          "title": "Primary",
          "type": "array"
        },
        "secondaryCurves": {
          "description": "Limiting Cs by Us, one curve per Cp (the secondary-system figure).",
          "items": {
            "$ref": "#/$defs/PondingCurve"
          },
          "title": "Secondarycurves",
          "type": "array"
        }
      },
      "required": [
        "limit",
        "secondary",
        "coefficient",
        "deck",
        "trussFactor",
        "stressLimit",
        "primary",
        "secondaryCurves"
      ],
      "title": "SteelPonding",
      "type": "object"
    },
    "SteelSlenderness": {
      "additionalProperties": false,
      "properties": {
        "compression": {
          "description": "KL/r limit of compression members.",
          "exclusiveMinimum": 0,
          "title": "Compression",
          "type": "number"
        },
        "tension": {
          "description": "L/r limit of tension members.",
          "exclusiveMinimum": 0,
          "title": "Tension",
          "type": "number"
        }
      },
      "required": [
        "compression",
        "tension"
      ],
      "title": "SteelSlenderness",
      "type": "object"
    },
    "SteelSlip": {
      "additionalProperties": false,
      "description": "Slip-critical connections: Rn = μ Du hsc Tb Ns.",
      "properties": {
        "phiServiceability": {
          "description": "φ, slip prevented as a serviceability limit.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Phiserviceability",
          "type": "number"
        },
        "phiStrength": {
          "description": "φ, slip prevented at the required strength.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Phistrength",
          "type": "number"
        },
        "mu": {
          "additionalProperties": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "description": "Mean slip coefficient by surface class.",
          "title": "Mu",
          "type": "object"
        },
        "Du": {
          "description": "Mean installed / specified minimum pretension.",
          "exclusiveMinimum": 0,
          "title": "Du",
          "type": "number"
        },
        "hsc": {
          "additionalProperties": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "description": "Hole factor by hole type.",
          "title": "Hsc",
          "type": "object"
        }
      },
      "required": [
        "phiServiceability",
        "phiStrength",
        "mu",
        "Du",
        "hsc"
      ],
      "title": "SteelSlip",
      "type": "object"
    },
    "SteelTensionField": {
      "additionalProperties": false,
      "description": "Stiffened webs: kv, tension field action and the transverse stiffeners.",
      "properties": {
        "kv": {
          "description": "kv = this + this / (a/h)² of stiffened webs.",
          "exclusiveMinimum": 0,
          "title": "Kv",
          "type": "number"
        },
        "aspectMax": {
          "description": "a/h above this: kv of an unstiffened web, no TFA.",
          "exclusiveMinimum": 0,
          "title": "Aspectmax",
          "type": "number"
        },
        "webLimit": {
          "description": "a/h above (this / (h/tw))²: likewise.",
          "exclusiveMinimum": 0,
          "title": "Weblimit",
          "type": "number"
        },
        "webFlange": {
          "description": "No TFA when 2 Aw / (Afc + Aft) exceeds this.",
          "exclusiveMinimum": 0,
          "title": "Webflange",
          "type": "number"
        },
        "depthFlange": {
          "description": "No TFA when h / bf exceeds this.",
          "exclusiveMinimum": 0,
          "title": "Depthflange",
          "type": "number"
        },
        "factor": {
          "description": "Vn = 0.6 Fy Aw (Cv + (1 - Cv) / (this √(1+(a/h)²))).",
