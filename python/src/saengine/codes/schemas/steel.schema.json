{
  "$defs": {
    "PondingCurve": {
      "additionalProperties": false,
      "properties": {
        "param": {
          "description": "The curve's flexibility constant (Cs or Cp).",
          "minimum": 0,
          "title": "Param",
          "type": "number"
        },
        "points": {
          "description": "[stress index U, upper limit of the other flexibility constant] pairs.",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Points",
          "type": "array"
        }
      },
      "required": [
        "param",
        "points"
      ],
      "title": "PondingCurve",
      "type": "object"
    },
    "SteelBars": {
      "additionalProperties": false,
      "description": "Rectangular bars and rounds in flexure.",
      "properties": {
        "plasticCap": {
          "description": "Mp at most this × My.",
          "exclusiveMinimum": 0,
          "title": "Plasticcap",
          "type": "number"
        },
        "yieldLimit": {
          "description": "Lb d / t² <= this E / Fy: yielding only.",
          "exclusiveMinimum": 0,
          "title": "Yieldlimit",
          "type": "number"
        },
        "ltbLimit": {
          "description": "... <= this E / Fy: inelastic LTB, else elastic.",
          "exclusiveMinimum": 0,
          "title": "Ltblimit",
          "type": "number"
        },
        "ltbA": {
          "description": "Mn = Cb (ltbA - ltbB (Lb d / t²) Fy / E) My.",
          "exclusiveMinimum": 0,
          "title": "Ltba",
          "type": "number"
        },
        "ltbB": {
          "description": "See ``ltbA``.",
          "exclusiveMinimum": 0,
          "title": "Ltbb",
          "type": "number"
        },
        "elastic": {
          "description": "Fcr = this E Cb / (Lb d / t²).",
          "exclusiveMinimum": 0,
          "title": "Elastic",
          "type": "number"
        }
      },
      "required": [
        "plasticCap",
        "yieldLimit",
        "ltbLimit",
        "ltbA",
        "ltbB",
        "elastic"
      ],
      "title": "SteelBars",
      "type": "object"
    },
    "SteelBoltGrade": {
      "additionalProperties": false,
      "description": "Nominal stresses of a bolt grade or a threaded part [MPa]: fixed values, or shares of the\npart's Fu (threaded parts).",
      "properties": {
        "Fnt": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Nominal tensile stress [MPa].",
          "title": "Fnt"
        },
        "Fnv": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Nominal shear stress, bearing-type [MPa].",
          "title": "Fnv"
        },
        "FntOfFu": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fnt as a share of Fu.",
          "title": "Fntoffu"
        },
        "FnvOfFu": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fnv as a share of Fu.",
          "title": "Fnvoffu"
        },
        "pretension": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Key of ``pretension`` (the bolt family); none: not pretensioned.",
          "title": "Pretension"
        }
      },
      "title": "SteelBoltGrade",
      "type": "object"
    },
    "SteelBracing": {
      "additionalProperties": false,
      "description": "Stability bracing of columns and beams (K = 1 between the braces).",
      "properties": {
        "phi": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Phi",
          "type": "number"
        },
        "columnRelative": {
          "$ref": "#/$defs/SteelBracingRow"
        },
        "columnNodal": {
          "$ref": "#/$defs/SteelBracingRow"
        },
        "beamRelative": {
          "$ref": "#/$defs/SteelBracingRow"
        },
        "beamNodal": {
          "$ref": "#/$defs/SteelBracingRow"
        },
        "torsionalMoment": {
          "description": "Mbr = this × Mr L / (n Cb Lb).",
          "exclusiveMinimum": 0,
          "title": "Torsionalmoment",
          "type": "number"
        },
        "torsionalStiffness": {
          "description": "βT = this × L Mr² / (n E Iy Cb²) / φ.",
          "exclusiveMinimum": 0,
          "title": "Torsionalstiffness",
          "type": "number"
        },
        "torsionalMomentForm": {
          "default": "spanRatio",
          "description": "Mbr of a nodal torsional brace: ``spanRatio`` (this × Mr L / (n Cb Lb)) or ``share`` (torsionalMoment × Mr).",
          "enum": [
            "spanRatio",
            "share"
          ],
          "title": "Torsionalmomentform",
          "type": "string"
        },
        "distortional": {
          "description": "βsec = this × E / ho × (...).",
          "exclusiveMinimum": 0,
          "title": "Distortional",
          "type": "number"
        },
        "slenderness": {
          "description": "L/r limit of stability bracing.",
          "exclusiveMinimum": 0,
          "title": "Slenderness",
          "type": "number"
        },
        "rows": {
          "default": false,
          "description": "List each brace's required strength and stiffness as flagged check rows.",
          "title": "Rows",
          "type": "boolean"
        }
      },
      "required": [
        "phi",
        "columnRelative",
        "columnNodal",
        "beamRelative",
        "beamNodal",
        "torsionalMoment",
        "torsionalStiffness",
        "distortional",
        "slenderness"
      ],
      "title": "SteelBracing",
      "type": "object"
    },
    "SteelBracingRow": {
      "additionalProperties": false,
      "description": "Required brace strength Pbr = strength × Pr (columns) or × Mr Cd / ho (beams), stiffness\nβbr = stiffness × Pr / Lb (or × Mr Cd / (Lb ho)) / φ.",
      "properties": {
        "strength": {
          "exclusiveMinimum": 0,
          "title": "Strength",
          "type": "number"
        },
        "stiffness": {
          "exclusiveMinimum": 0,
          "title": "Stiffness",
          "type": "number"
        }
      },
      "required": [
        "strength",
        "stiffness"
      ],
      "title": "SteelBracingRow",
      "type": "object"
    },
    "SteelBuiltUp": {
      "additionalProperties": false,
      "description": "Built-up compression members: modified slenderness and dimensional limits.",
      "properties": {
        "welded": {
          "description": "Welded / pretensioned connectors: this α²/(1+α²).",
          "exclusiveMinimum": 0,
          "title": "Welded",
          "type": "number"
        },
        "componentShare": {
          "description": "K a / ri at most this × the member's KL/r.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Componentshare",
          "type": "number"
        },
        "componentK": {
          "description": "K of a component between connectors.",
          "exclusiveMinimum": 0,
          "title": "Componentk",
          "type": "number"
        },
        "plateSpacing": {
          "description": "Outside plate: spacing <= this √(E/Fy) t ...",
          "exclusiveMinimum": 0,
          "title": "Platespacing",
          "type": "number"
        },
        "plateSpacingMax": {
          "description": "... and at most this [mm].",
          "exclusiveMinimum": 0,
          "title": "Platespacingmax",
          "type": "number"
        },
        "plateStaggered": {
          "description": "Staggered fasteners: <= this √(E/Fy) t ...",
          "exclusiveMinimum": 0,
          "title": "Platestaggered",
          "type": "number"
        },
        "plateStaggeredMax": {
          "description": "... and at most this [mm].",
          "exclusiveMinimum": 0,
          "title": "Platestaggeredmax",
          "type": "number"
        },
        "lacingSingle": {
          "description": "L/r of single lacing bars at most this.",
          "exclusiveMinimum": 0,
          "title": "Lacingsingle",
          "type": "number"
        },
        "lacingDouble": {
          "description": "L/r of double lacing bars at most this.",
          "exclusiveMinimum": 0,
          "title": "Lacingdouble",
          "type": "number"
        },
        "lacingShear": {
          "description": "Lacing shear: this × φc Pn of the member.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Lacingshear",
          "type": "number"
        },
        "lacingDoubleLength": {
          "description": "Double lacing: L = this × the bar length.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Lacingdoublelength",
          "type": "number"
        },
        "tiePlateEnd": {
          "description": "End tie plate length >= this × line distance.",
          "exclusiveMinimum": 0,
          "title": "Tieplateend",
          "type": "number"
        },
        "tiePlateIntermediate": {
          "description": "Intermediate: >= this × the distance.",
          "exclusiveMinimum": 0,
          "title": "Tieplateintermediate",
          "type": "number"
        },
        "tiePlateThickness": {
          "description": "Tie plate t >= this × the line distance.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Tieplatethickness",
          "type": "number"
        },
        "method": {
          "default": "alpha",
          "description": "Welded or pretensioned connectors: ``alpha`` ((KL/r)m with α = h / 2rib and ``welded``) or ``ki`` ((KL/r)o up to a/ri = ``kiLimit``, above it √((KL/r)o² + (Ki a/ri)²) with Ki by the components, ``ki``).",
          "enum": [
            "alpha",
            "ki"
          ],
          "title": "Method",
          "type": "string"
        },
        "kiLimit": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "``ki``: a/ri up to which (KL/r)m = (KL/r)o.",
          "title": "Kilimit"
        },
        "ki": {
          "additionalProperties": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "description": "``ki``: Ki by the components: ``angles`` (back-to-back), ``channels`` (back-to-back), ``other``.",
          "title": "Ki",
          "type": "object"
        }
      },
      "required": [
        "welded",
        "componentShare",
        "componentK",
        "plateSpacing",
        "plateSpacingMax",
        "plateStaggered",
        "plateStaggeredMax",
        "lacingSingle",
        "lacingDouble",
        "lacingShear",
        "lacingDoubleLength",
        "tiePlateEnd",
        "tiePlateIntermediate",
        "tiePlateThickness"
      ],
      "title": "SteelBuiltUp",
      "type": "object"
    },
    "SteelConnectionData": {
      "additionalProperties": false,
      "description": "Bolts, holes, edges and fillet welds of steel connections.",
      "properties": {
        "boltGrades": {
          "additionalProperties": {
            "$ref": "#/$defs/SteelBoltGrade"
          },
          "title": "Boltgrades",
          "type": "object"
        },
        "boltAliases": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Other grade names taken as a grade of ``boltGrades`` (labelled in ``sources.boltAliases``).",
          "title": "Boltaliases",
          "type": "object"
        },
        "pretension": {
          "additionalProperties": {
            "additionalProperties": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "type": "object"
          },
          "description": "Minimum bolt pretension Tb [kN] by bolt family and diameter [mm].",
          "title": "Pretension",
          "type": "object"
        },
        "slip": {
          "$ref": "#/$defs/SteelSlip"
        },
        "holes": {
          "additionalProperties": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "description": "Standard hole diameter [mm] by bolt diameter.",
          "title": "Holes",
          "type": "object"
        },
        "holeOver": {
          "description": "Larger bolts: standard hole d + this [mm].",
          "exclusiveMinimum": 0,
          "title": "Holeover",
          "type": "number"
        },
        "netHoleAllowance": {
          "description": "Hole width + this for net areas [mm].",
          "minimum": 0,
          "title": "Netholeallowance",
          "type": "number"
        },
        "edgeRolled": {
          "additionalProperties": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "description": "Minimum edge distance, rolled [mm].",
          "title": "Edgerolled",
          "type": "object"
        },
        "edgeSheared": {
          "additionalProperties": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "description": "Minimum edge distance, sheared [mm].",
          "title": "Edgesheared",
          "type": "object"
        },
        "edgeOverRolled": {
          "description": "Larger bolts, rolled edges: this × d.",
          "exclusiveMinimum": 0,
          "title": "Edgeoverrolled",
          "type": "number"
        },
        "edgeOverSheared": {
          "description": "Larger bolts, sheared edges: this × d.",
          "exclusiveMinimum": 0,
          "title": "Edgeoversheared",
          "type": "number"
        },
        "minSpacing": {
          "description": "Least bolt spacing as a multiple of d.",
          "exclusiveMinimum": 0,
          "title": "Minspacing",
          "type": "number"
        },
        "maxEdgeThickness": {
          "description": "Largest edge distance: this × t ...",
          "exclusiveMinimum": 0,
          "title": "Maxedgethickness",
          "type": "number"
        },
        "maxEdge": {
          "description": "... and at most this [mm].",
          "exclusiveMinimum": 0,
          "title": "Maxedge",
          "type": "number"
        },
        "longJointLength": {
          "description": "Tension splices: bolt pattern longer than this [mm] ...",
          "exclusiveMinimum": 0,
          "title": "Longjointlength",
          "type": "number"
        },
        "longJointFactor": {
          "description": "... has Fnv times this.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Longjointfactor",
          "type": "number"
        },
        "filletMin": {
          "description": "Minimum fillet weld leg by the thinner part: [[t up to (null: above), leg [mm]], ...].",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              {
                "exclusiveMinimum": 0,
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Filletmin",
          "type": "array"
        },
        "filletMaxThin": {
          "description": "Along edges thinner than this, the leg is at most the thickness [mm] ...",
          "exclusiveMinimum": 0,
          "title": "Filletmaxthin",
          "type": "number"
        },
        "filletMaxReduce": {
          "description": "... else the thickness less this [mm].",
          "minimum": 0,
          "title": "Filletmaxreduce",
          "type": "number"
        },
        "concreteBearingFull": {
          "description": "Pp / (f'c A1) on the full concrete area.",
          "exclusiveMinimum": 0,
          "title": "Concretebearingfull",
          "type": "number"
        },
        "concreteBearingPartial": {
          "description": "Pp / (f'c A1 √(A2/A1)) on part of the concrete area ...",
          "exclusiveMinimum": 0,
          "title": "Concretebearingpartial",
          "type": "number"
        },
        "concreteBearingMax": {
          "description": "... and Pp / (f'c A1) at most this.",
          "exclusiveMinimum": 0,
          "title": "Concretebearingmax",
          "type": "number"
        },
        "methods": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Method ids where the code gives a requirement but no method (e.g. ``prying``: ``tStub``); a missing key: the check is not made.",
          "title": "Methods",
          "type": "object"
        },
        "references": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Alpha 9 C3: the clause references the connection notes are written with (the default pack's) -> this pack's references; empty: the notes as written.",
          "title": "References",
          "type": "object"
        }
      },
      "required": [
        "boltGrades",
        "pretension",
        "slip",
        "holes",
        "holeOver",
        "netHoleAllowance",
        "edgeRolled",
        "edgeSheared",
        "edgeOverRolled",
        "edgeOverSheared",
        "minSpacing",
        "maxEdgeThickness",
        "maxEdge",
        "longJointLength",
        "longJointFactor",
        "filletMin",
        "filletMaxThin",
        "filletMaxReduce",
        "concreteBearingFull",
        "concreteBearingPartial",
        "concreteBearingMax"
      ],
      "title": "SteelConnectionData",
      "type": "object"
    },
    "SteelEffectiveWidthFactors": {
      "additionalProperties": false,
      "description": "Alpha 9 C3: the imperfection factors c1, c2 of the effective width of a slender element\nin compression, be = b (1 - c1 √(Fel/Fcr)) √(Fel/Fcr), Fel = (c2 λr/λ)² Fy.",
      "properties": {
        "c1": {
          "exclusiveMinimum": 0,
          "title": "C1",
          "type": "number"
        },
        "c2": {
          "exclusiveMinimum": 0,
          "title": "C2",
          "type": "number"
        }
      },
      "required": [
        "c1",
        "c2"
      ],
      "title": "SteelEffectiveWidthFactors",
      "type": "object"
    },
    "SteelMemberMethods": {
      "additionalProperties": false,
      "description": "Alpha 9 C3: the member strength methods a pack chooses where its steel code differs from\nthe default pack's (each a method id of :mod:`saengine.design.steel.members`; a missing\ngroup: the default pack's methods).",
      "properties": {
        "compressionSlender": {
          "default": "formFactor",
          "description": "Slender elements in compression: ``formFactor`` (Q = Qs Qa, Fcr of Q Fy) or ``effectiveWidth`` (Pn = Fcr Ae with the effective widths of every slender element).",
          "enum": [
            "formFactor",
            "effectiveWidth"
          ],
          "title": "Compressionslender",
          "type": "string"
        },
        "effectiveWidth": {
          "additionalProperties": {
            "$ref": "#/$defs/SteelEffectiveWidthFactors"
          },
          "description": "c1, c2 of ``effectiveWidth`` by element kind: ``stiffened`` (webs and other stiffened elements), ``hssWalls`` (walls of rectangular HSS), ``other`` (unstiffened elements: flanges, legs, stems).",
          "title": "Effectivewidth",
          "type": "object"
        },
        "roundEffectiveArea": {
          "default": [
            0.038,
            0.6667
          ],
          "description": "Round HSS with a slender wall: Ae / Ag (or Q) = a E / (Fy D/t) + b: [a, b].",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          ],
          "title": "Roundeffectivearea",
          "type": "array"
        },
        "webShear": {
          "default": "cv",
          "description": "Webs of I-shapes and channels without tension field action: ``cv`` (Cv with the elastic branch) or ``cv1`` (Cv1 = 1.10 √(kv E/Fy) / (h/tw) at most 1).",
          "enum": [
            "cv",
            "cv1"
          ],
          "title": "Webshear",
          "type": "string"
        },
        "kvUnstiffened": {
          "default": 5.0,
          "description": "kv of an unstiffened web (and of a/h beyond the limits).",
          "exclusiveMinimum": 0,
          "title": "Kvunstiffened",
          "type": "number"
        },
        "tensionField": {
          "default": "limited",
          "description": "Panels outside the proportion limits of tension field action: ``limited`` (none counted) or ``reduced`` (the denominator 1.15 (a/h + √(1+(a/h)²))).",
          "enum": [
            "limited",
            "reduced"
          ],
          "title": "Tensionfield",
          "type": "string"
        },
        "teeFlexure": {
          "default": "criticalMoment",
          "description": "Tees about the major axis: ``criticalMoment`` (Mn the least of Mp and Mcr) or ``lengthLimits`` (Lp, Lr of the stem in tension, stem local buckling, flange local buckling by λp, λr).",
          "enum": [
            "criticalMoment",
            "lengthLimits"
          ],
          "title": "Teeflexure",
          "type": "string"
        },
        "teeCompression": {
          "default": "twoStress",
          "description": "Flexural-torsional buckling of tees: ``twoStress`` (Fcry, Fcrz, H) or ``general`` (Fe of singly symmetric members, then the flexural buckling curve).",
          "enum": [
            "twoStress",
            "general"
          ],
          "title": "Teecompression",
          "type": "string"
        },
        "hssLateralTorsional": {
          "default": false,
          "description": "Rectangular HSS about the major axis also checked for lateral-torsional buckling with Lp = a E ry √(J A) / Mp and Lr = b E ry √(J A) / (0.7 Fy Sx).",
          "title": "Hsslateraltorsional",
          "type": "boolean"
        },
        "hssLtb": {
          "default": [
            0.13,
            2.0
          ],
          "description": "[a, b] of ``hssLateralTorsional``.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          ],
          "title": "Hssltb",
          "type": "array"
        },
        "teeStem": {
          "default": [
            0.84,
            1.52,
            1.43,
            0.515,
            1.52
          ],
          "description": "Tee stems in flexural compression: d/tw <= a √(E/Fy) Fcr = Fy; <= b √(E/Fy) Fcr = (c - d (d/tw) √(Fy/E)) Fy; above Fcr = e E / (d/tw)².",
          "maxItems": 5,
          "minItems": 5,
          "prefixItems": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          ],
          "title": "Teestem",
          "type": "array"
        },
        "teeFlangeSlender": {
          "default": 0.7,
          "description": "Slender tee flange: Mn = this E Sxc / (bf/2tf)².",
          "exclusiveMinimum": 0,
          "title": "Teeflangeslender",
          "type": "number"
        },
        "columnCurve": {
          "default": "exponential",
          "description": "Flexural buckling: ``exponential`` (Fcr = 0.658^(Fy/Fe) Fy, 0.877 Fe) or ``powerCurve`` (Fcr = Fy (1 + λ^2n)^(-1/n), λ = √(Fy/Fe), n by section family).",
          "enum": [
            "exponential",
