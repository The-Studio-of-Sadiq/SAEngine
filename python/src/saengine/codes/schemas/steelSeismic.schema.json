    "SteelSeismicExpected": {
      "additionalProperties": false,
      "description": "A row of the expected strength ratios: the steels it covers and Ry, Rt.",
      "properties": {
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Clause (and page) of this row.",
          "title": "Source"
        },
        "application": {
          "description": "Hot-rolled shapes and bars, hollow sections, pipe or plates.",
          "enum": [
            "shapes",
            "hss",
            "pipe",
            "plates"
          ],
          "title": "Application",
          "type": "string"
        },
        "match": {
          "description": "Regular expressions; a material matches when one is found in its grade, standard, id or name (case ignored).",
