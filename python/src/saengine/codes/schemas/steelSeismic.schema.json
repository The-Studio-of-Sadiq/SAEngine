            "type": "string"
          },
          "minItems": 1,
          "title": "Match",
          "type": "array"
        },
        "fyMin": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Least Fy of the row [MPa].",
          "title": "Fymin"
        },
        "fyMax": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Largest Fy of the row [MPa].",
          "title": "Fymax"
        },
        "Ry": {
          "description": "Expected yield stress / Fy.",
          "minimum": 1,
          "title": "Ry",
          "type": "number"
        },
        "Rt": {
          "description": "Expected tensile strength / Fu.",
          "minimum": 1,
          "title": "Rt",
          "type": "number"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
