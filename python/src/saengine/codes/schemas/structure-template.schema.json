          "title": "Bracing type"
        },
        "bracedBays": {
          "description": "Bays with X-bracing, 1 = the first; empty: the first and the last bay.",
          "items": {
            "type": "integer"
          },
          "title": "Braced bays",
          "type": "array"
        },
        "roofBracingPanels": {
          "default": 2,
          "description": "X-braced panels along each roof slope in a braced bay.",
          "maximum": 20,
          "minimum": 1,
          "title": "Roof bracing panels",
          "type": "integer"
        },
        "roofPanelType": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Slab type of roof cladding panels (they carry the roof area loads); none adds no panels.",
          "title": "Roof panel type"
        },
        "wallPanelType": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._-]+$",
              "type": "string"
            },
            {
