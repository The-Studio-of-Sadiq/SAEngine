        },
        "y": {
          "description": "[mm]",
          "title": "Y",
          "type": "number"
        },
        "z": {
          "description": "Elevation [mm].",
          "title": "Z",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "title": "Point",
      "type": "object"
    },
    "SpaceTruss": {
