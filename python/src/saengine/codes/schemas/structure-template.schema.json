  "additionalProperties": false,
  "description": "A preset of a built-in parametric shape (``templates/<name>.json``).",
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "$Schema"
    },
    "name": {
      "description": "Name in the shape list, e.g. 'Warren truss 24 m'.",
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "shape": {
      "description": "The shape and its parameters, as the Generate panel edits them.",
      "discriminator": {
        "mapping": {
          "arch": "#/$defs/Arch",
          "barrelVault": "#/$defs/BarrelVault",
          "cableNet": "#/$defs/CableNet",
          "dome": "#/$defs/Dome",
          "planeTruss": "#/$defs/PlaneTruss",
          "spaceTruss": "#/$defs/SpaceTruss"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/SpaceTruss"
        },
        {
          "$ref": "#/$defs/PlaneTruss"
        },
        {
          "$ref": "#/$defs/Arch"
        },
        {
          "$ref": "#/$defs/Dome"
        },
        {
          "$ref": "#/$defs/BarrelVault"
        },
        {
          "$ref": "#/$defs/CableNet"
        }
      ],
      "title": "Shape"
    }
  },
  "required": [
    "name",
    "shape"
  ],
  "title": "SAEngine structure template (a shape preset)",
  "type": "object",
  "$id": "saengine.structureTemplate/1"
