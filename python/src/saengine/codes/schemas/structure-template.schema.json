        "rise",
        "length",
        "segments",
        "bays",
        "memberType"
      ],
      "title": "BarrelVault",
      "type": "object"
    },
    "CableNet": {
      "additionalProperties": false,
      "description": "A saddle-shaped (hyperbolic paraboloid) net of cables over a rectangle.\n\nIts corners lie at z = 0; the edges rise by ``rise`` at the middle of the x edges and fall by\nit at the middle of the y edges. Cables are drawn as members: a tension-only brace type\n(Part 4) releases the ones a combination compresses (:mod:`saengine.fem.tension_only`);\nprestress and large displacements come with the nonlinear analyses.",
      "properties": {
        "kind": {
          "const": "cableNet",
          "default": "cableNet",
          "title": "Kind",
          "type": "string"
        },
        "lengthX": {
          "description": "[mm]",
          "exclusiveMinimum": 0,
          "title": "Length X",
          "type": "number"
        },
        "lengthY": {
          "description": "[mm]",
          "exclusiveMinimum": 0,
          "title": "Length Y",
          "type": "number"
        },
        "divisionsX": {
          "maximum": 400,
          "minimum": 2,
          "title": "Divisions in X",
          "type": "integer"
        },
        "divisionsY": {
          "maximum": 400,
          "minimum": 2,
          "title": "Divisions in Y",
          "type": "integer"
        },
        "rise": {
          "description": "Saddle height at the middle of the edges [mm].",
          "title": "Rise",
          "type": "number"
        },
        "memberType": {
          "description": "Object type of the cables.",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Member type",
          "type": "string"
        },
        "edgeType": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Object type of the edge members; none uses the member type.",
          "title": "Edge type"
        },
        "supports": {
          "default": "pinned",
          "description": "Supports added where the shape meets the ground.",
          "enum": [
            "none",
            "pinned",
            "fixed"
          ],
          "title": "Supports",
          "type": "string"
        },
        "supportAt": {
          "default": "perimeter",
          "enum": [
            "corners",
            "perimeter"
          ],
          "title": "Supports at",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/Point",
          "description": "Where the shape's own origin is placed [mm].",
          "title": "Origin"
        },
        "rotation": {
          "default": 0,
          "description": "Rotation in plan about the origin [°].",
          "title": "Rotation",
          "type": "number"
        }
      },
      "required": [
        "lengthX",
        "lengthY",
        "divisionsX",
        "divisionsY",
        "rise",
        "memberType"
      ],
      "title": "CableNet",
      "type": "object"
    },
    "DeckGrillage": {
      "additionalProperties": false,
      "description": "A bridge deck as a grillage: girders along x (the spans), transverse members across y\nat every station (the deck slab's strips and the diaphragms), supported under every\ngirder at each support line. The origin is the first girder's start; girders are\n``girderSpacing`` apart along +y.",
      "properties": {
        "kind": {
          "const": "deckGrillage",
          "default": "deckGrillage",
          "title": "Kind",
          "type": "string"
        },
        "spans": {
          "description": "Span lengths in order [mm].",
          "items": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "minItems": 1,
          "title": "Spans",
          "type": "array"
        },
        "girders": {
          "description": "Girders across the deck.",
          "maximum": 20,
          "minimum": 1,
          "title": "Girders",
          "type": "integer"
        },
        "girderSpacing": {
          "description": "[mm].",
          "exclusiveMinimum": 0,
          "title": "Girder spacing",
          "type": "number"
        },
        "divisions": {
          "default": 10,
          "description": "Elements of each girder in each span.",
          "maximum": 100,
          "minimum": 2,
          "title": "Divisions",
          "type": "integer"
        },
        "memberType": {
          "description": "Object type of the girders.",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Girder type",
          "type": "string"
        },
        "crossType": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Object type of the transverse members (deck strips, diaphragms); none uses the girder type.",
          "title": "Transverse type"
        },
        "panelType": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Slab or wall type of the cladding panels between the members; none adds no panels.",
          "title": "Panel type"
        },
        "supports": {
          "default": "pinned",
          "description": "Supports added where the shape meets the ground.",
          "enum": [
            "none",
            "pinned",
            "fixed"
          ],
          "title": "Supports",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/Point",
          "description": "Where the shape's own origin is placed [mm].",
          "title": "Origin"
        },
        "rotation": {
          "default": 0,
          "description": "Rotation in plan about the origin [°].",
          "title": "Rotation",
          "type": "number"
        }
      },
      "required": [
        "spans",
        "girders",
        "girderSpacing",
        "memberType"
      ],
      "title": "DeckGrillage",
      "type": "object"
    },
