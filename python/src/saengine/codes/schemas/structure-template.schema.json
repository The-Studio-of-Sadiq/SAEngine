          "title": "Rotation",
          "type": "number"
        }
      },
      "required": [
        "width",
        "length",
        "bays",
        "eaveHeight",
        "columnType",
        "rafterType"
      ],
      "title": "PortalFrame",
      "type": "object"
    },
