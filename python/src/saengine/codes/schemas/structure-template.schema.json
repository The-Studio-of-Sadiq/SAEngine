{
  "$defs": {
    "Arch": {
      "additionalProperties": false,
      "description": "A single arch in its own vertical plane along x, springing at z = 0.",
      "properties": {
        "kind": {
          "const": "arch",
          "default": "arch",
          "title": "Kind",
          "type": "string"
        },
        "span": {
          "description": "[mm]",
          "exclusiveMinimum": 0,
          "title": "Span",
          "type": "number"
        },
        "rise": {
          "description": "Of the crown above the springings [mm].",
          "exclusiveMinimum": 0,
          "title": "Rise",
          "type": "number"
        },
        "segments": {
          "description": "Straight members along the arch.",
          "maximum": 400,
          "minimum": 2,
          "title": "Segments",
          "type": "integer"
        },
        "form": {
          "default": "circular",
          "enum": [
            "circular",
            "parabolic"
          ],
          "title": "Form",
          "type": "string"
        },
        "memberType": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Member type",
          "type": "string"
        },
        "supports": {
          "default": "pinned",
          "description": "Supports added where the shape meets the ground.",
          "enum": [
            "none",
            "pinned",
            "fixed"
          ],
          "title": "Supports",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/Point",
          "description": "Where the shape's own origin is placed [mm].",
          "title": "Origin"
        },
        "rotation": {
          "default": 0,
          "description": "Rotation in plan about the origin [°].",
          "title": "Rotation",
          "type": "number"
        }
      },
      "required": [
        "span",
        "rise",
        "segments",
        "memberType"
      ],
      "title": "Arch",
      "type": "object"
    },
    "BarrelVault": {
