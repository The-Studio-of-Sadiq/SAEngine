        "rise": {
          "description": "Of the crown above the springings [mm].",
          "exclusiveMinimum": 0,
          "title": "Rise",
          "type": "number"
        },
        "length": {
          "description": "[mm]",
          "exclusiveMinimum": 0,
          "title": "Length",
          "type": "number"
        },
        "segments": {
