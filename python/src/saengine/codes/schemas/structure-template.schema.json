          "title": "Diagonal type"
        },
        "supports": {
          "default": "pinned",
          "description": "Supports added where the shape meets the ground.",
          "enum": [
            "none",
            "pinned",
            "fixed"
          ],
          "title": "Supports",
          "type": "string"
        },
        "supportAt": {
          "default": "perimeter",
