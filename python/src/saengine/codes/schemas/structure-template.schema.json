          "title": "Bays in Y",
          "type": "integer"
        },
        "depth": {
          "description": "Between the top and bottom layers [mm].",
          "exclusiveMinimum": 0,
          "title": "Depth",
          "type": "number"
        },
        "memberType": {
          "description": "Object type of the chords.",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Member type",
          "type": "string"
        },
        "diagonalType": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._-]+$",
