$ File synthetic two_story_frame.e2k written by hand for the SAEngine importer tests

$ PROGRAM INFORMATION
  PROGRAM  "ETABS"  VERSION "21.0.0"

$ CONTROLS
  UNITS  "KN"  "M"  "C"
  TITLE2  "Two story test frame"
  PREFERENCE  MERGETOL 0.001

$ STORIES - IN SEQUENCE FROM TOP
  STORY "Story2"  HEIGHT 3.2  MASTERSTORY "Yes"
  STORY "Story1"  HEIGHT 3.5  SIMILARTO "Story2"
  STORY "Base"  ELEV 0

$ GRIDS
  GRIDSYSTEM "G1"  TYPE "CARTESIAN"  BUBBLESIZE 1.25
  GRID "G1"  LABEL "A"  DIR "X"  COORD 0  VISIBLE "Yes"  BUBBLELOC "End"
  GRID "G1"  LABEL "B"  DIR "X"  COORD 6  VISIBLE "Yes"  BUBBLELOC "End"
  GRID "G1"  LABEL "C"  DIR "X"  COORD 12  VISIBLE "Yes"  BUBBLELOC "End"
  GRID "G1"  LABEL "1"  DIR "Y"  COORD 0  VISIBLE "Yes"  BUBBLELOC "Start"
  GRID "G1"  LABEL "2"  DIR "Y"  COORD 5  VISIBLE "Yes"  BUBBLELOC "Start"

$ DIAPHRAGM NAMES
  DIAPHRAGM "D1"  TYPE RIGID

$ MATERIAL PROPERTIES
  MATERIAL  "C25"  TYPE "Concrete"  WEIGHTPERVOLUME 23.53596
  MATERIAL  "C25"  SYMTYPE "Isotropic"  E 23500000  U 0.2  A 0.0000099
  MATERIAL  "C25"  FC 25000
  MATERIAL  "A992Fy50"  TYPE "Steel"  WEIGHTPERVOLUME 76.98220
  MATERIAL  "A992Fy50"  SYMTYPE "Isotropic"  E 200000000  U 0.3  A 0.0000117
  MATERIAL  "A992Fy50"  FY 345000  FU 450000  FYE 379500  FUE 495000
  MATERIAL  "B420"  TYPE "Rebar"  WEIGHTPERVOLUME 76.98220
  MATERIAL  "B420"  SYMTYPE "Uniaxial"  E 200000000  A 0.0000117
  MATERIAL  "B420"  FY 420000  FU 525000

$ FRAME SECTIONS
  FRAMESECTION  "C400"  MATERIAL "C25"  SHAPE "Concrete Rectangular"  D 0.4  B 0.4
  FRAMESECTION  "B300x500"  MATERIAL "C25"  SHAPE "Concrete Rectangular"  D 0.5  B 0.3
  FRAMESECTION  "HSS150x8"  MATERIAL "A992Fy50"  SHAPE "Steel Tube"  D 0.15  B 0.15  TF 0.008  TW 0.008
  FRAMESECTION  "W14X90"  MATERIAL "A992Fy50"  SHAPE "W14X90"

$ CONCRETE SECTIONS
  CONCRETESECTION "C400"  LONGBARMATERIAL "B420"  CONFINEBARMATERIAL "B420"  TYPE "Column"  PATTERN "Rectangle"  CONFINEMENT "Ties"  COVER 0.04  NUMBARS3DIR 3  NUMBARS2DIR 3  BARSIZE "20d"  TIESIZE "10d"  TIESPACING 0.15  NUMR3BARS 2  NUMR2BARS 2  DESIGNTYPE "Check"
  CONCRETESECTION "B300x500"  LONGBARMATERIAL "B420"  CONFINEBARMATERIAL "B420"  TYPE "Beam"  COVERTOP 0.05  COVERBOTTOM 0.05

$ SHELL PROPERTIES
  SHELLPROP  "S150"  PROPTYPE  "Slab"  MATERIAL "C25"  MODELINGTYPE "ShellThin"  SLABTYPE "Slab"  SLABTHICKNESS 0.15
  SHELLPROP  "W200"  PROPTYPE  "Wall"  MATERIAL "C25"  MODELINGTYPE "ShellThin"  WALLTHICKNESS 0.2

$ POINT COORDINATES
  POINT "1"  0  0
  POINT "2"  6  0
  POINT "3"  12  0
  POINT "4"  0  5
  POINT "5"  6  5
  POINT "6"  12  5

$ LINE CONNECTIVITIES
  LINE  "C1"  COLUMN  "1"  "1"  1
  LINE  "C2"  COLUMN  "2"  "2"  1
  LINE  "C3"  COLUMN  "3"  "3"  1
  LINE  "C4"  COLUMN  "4"  "4"  1
  LINE  "C5"  COLUMN  "5"  "5"  1
  LINE  "C6"  COLUMN  "6"  "6"  1
  LINE  "B1"  BEAM  "1"  "2"  0
  LINE  "B2"  BEAM  "2"  "3"  0
  LINE  "B3"  BEAM  "4"  "5"  0
  LINE  "B4"  BEAM  "5"  "6"  0
  LINE  "B5"  BEAM  "1"  "4"  0
  LINE  "B6"  BEAM  "2"  "5"  0
  LINE  "B7"  BEAM  "3"  "6"  0
  LINE  "D1"  BRACE  "1"  "2"  1

$ AREA CONNECTIVITIES
  AREA "F1"  FLOOR  4  "1"  "2"  "5"  "4"  0  0  0  0
  AREA "F2"  FLOOR  4  "2"  "3"  "6"  "5"  0  0  0  0
  AREA "W1"  PANEL  4  "3"  "6"  "6"  "3"  1  1  0  0

$ POINT ASSIGNS
  POINTASSIGN  "1"  "Base"  RESTRAINT "UX UY UZ RX RY RZ"
  POINTASSIGN  "2"  "Base"  RESTRAINT "UX UY UZ RX RY RZ"
  POINTASSIGN  "3"  "Base"  RESTRAINT "UX UY UZ RX RY RZ"
  POINTASSIGN  "4"  "Base"  RESTRAINT "UX UY UZ RX RY RZ"
  POINTASSIGN  "5"  "Base"  RESTRAINT "UX UY UZ RX RY RZ"
  POINTASSIGN  "6"  "Base"  RESTRAINT "UX UY UZ RX RY RZ"
  POINTASSIGN  "5"  "Story1"  DIAPH "D1"

$ LINE ASSIGNS
  LINEASSIGN  "C1"  "Story2"  SECTION "C400"  MINNUMSTA 3  AUTOMESH "YES"
  LINEASSIGN  "C2"  "Story2"  SECTION "C400"
  LINEASSIGN  "C3"  "Story2"  SECTION "C400"
  LINEASSIGN  "C4"  "Story2"  SECTION "C400"
  LINEASSIGN  "C5"  "Story2"  SECTION "C400"
  LINEASSIGN  "C6"  "Story2"  SECTION "C400"
  LINEASSIGN  "C1"  "Story1"  SECTION "C400"
  LINEASSIGN  "C2"  "Story1"  SECTION "C400"
  LINEASSIGN  "C3"  "Story1"  SECTION "C400"
  LINEASSIGN  "C4"  "Story1"  SECTION "C400"
  LINEASSIGN  "C5"  "Story1"  SECTION "C400"
  LINEASSIGN  "C6"  "Story1"  SECTION "C400"
  LINEASSIGN  "B1"  "Story2"  SECTION "B300x500"
  LINEASSIGN  "B2"  "Story2"  SECTION "B300x500"
  LINEASSIGN  "B3"  "Story2"  SECTION "B300x500"
  LINEASSIGN  "B4"  "Story2"  SECTION "B300x500"
  LINEASSIGN  "B5"  "Story2"  SECTION "B300x500"
  LINEASSIGN  "B6"  "Story2"  SECTION "B300x500"
  LINEASSIGN  "B7"  "Story2"  SECTION "B300x500"
  LINEASSIGN  "B1"  "Story1"  SECTION "B300x500"
  LINEASSIGN  "B2"  "Story1"  SECTION "B300x500"
  LINEASSIGN  "B3"  "Story1"  SECTION "B300x500"
  LINEASSIGN  "B4"  "Story1"  SECTION "B300x500"
  LINEASSIGN  "B5"  "Story1"  SECTION "B300x500"
  LINEASSIGN  "B6"  "Story1"  SECTION "B300x500"
  LINEASSIGN  "B7"  "Story1"  SECTION "B300x500"
  LINEASSIGN  "D1"  "Story1"  SECTION "HSS150x8"  RELEASE "TI M2I M3I M2J M3J"

$ AREA ASSIGNS
  AREAASSIGN  "F1"  "Story2"  SECTION "S150"  DIAPH "D1"
  AREAASSIGN  "F2"  "Story2"  SECTION "S150"  DIAPH "D1"
  AREAASSIGN  "F1"  "Story1"  SECTION "S150"  DIAPH "D1"
  AREAASSIGN  "F2"  "Story1"  SECTION "S150"  DIAPH "D1"
  AREAASSIGN  "W1"  "Story1"  SECTION "W200"  PIER "P1"

$ LOAD PATTERNS
  LOADPATTERN "Dead"  TYPE  "Dead"  SELFWEIGHT  1
  LOADPATTERN "SDL"  TYPE  "Super Dead"  SELFWEIGHT  0
  LOADPATTERN "Live"  TYPE  "Live"  SELFWEIGHT  0
  LOADPATTERN "RLive"  TYPE  "Roof Live"  SELFWEIGHT  0
  LOADPATTERN "EQX"  TYPE  "Seismic"  SELFWEIGHT  0
  LOADPATTERN "EQY"  TYPE  "Seismic"  SELFWEIGHT  0
  SEISMIC "EQX"  "BNBC 2020"  DIR "X"  ECC 0.05

$ POINT OBJECT LOADS
  POINTLOAD  "5"  "Story2"  TYPE "FORCE"  LC "Live"  FZ -20

$ FRAME OBJECT LOADS
  LINELOAD  "B3"  "Story1"  TYPE "UNIFF"  DIR "GRAV"  LC "SDL"  FVAL 10

$ SHELL OBJECT LOADS
  AREALOAD  "F1"  "Story2"  TYPE "UNIFF"  DIR "GRAV"  LC "SDL"  FVAL 1.5
  AREALOAD  "F2"  "Story2"  TYPE "UNIFF"  DIR "GRAV"  LC "SDL"  FVAL 1.5
  AREALOAD  "F1"  "Story1"  TYPE "UNIFF"  DIR "GRAV"  LC "SDL"  FVAL 1.5
  AREALOAD  "F2"  "Story1"  TYPE "UNIFF"  DIR "GRAV"  LC "SDL"  FVAL 1.5
  AREALOAD  "F1"  "Story1"  TYPE "UNIFF"  DIR "GRAV"  LC "Live"  FVAL 2
  AREALOAD  "F2"  "Story1"  TYPE "UNIFF"  DIR "GRAV"  LC "Live"  FVAL 2
  AREALOAD  "F1"  "Story2"  TYPE "UNIFF"  DIR "GRAV"  LC "RLive"  FVAL 1
  AREALOAD  "F2"  "Story2"  TYPE "UNIFF"  DIR "GRAV"  LC "RLive"  FVAL 1

$ LOAD CASES
  LOADCASE "Modal"  TYPE  "Modal - Eigen"  INITCOND  "PRESET"
  LOADCASE "Dead"  TYPE  "Linear Static"  INITCOND  "PRESET"
  LOADCASE "Dead"  LOADPAT  "Dead"  SF  1
  LOADCASE "SDL"  TYPE  "Linear Static"  INITCOND  "PRESET"
  LOADCASE "SDL"  LOADPAT  "SDL"  SF  1
  LOADCASE "Live"  TYPE  "Linear Static"  INITCOND  "PRESET"
  LOADCASE "Live"  LOADPAT  "Live"  SF  1
  LOADCASE "RLive"  TYPE  "Linear Static"  INITCOND  "PRESET"
  LOADCASE "RLive"  LOADPAT  "RLive"  SF  1
  LOADCASE "EQX"  TYPE  "Linear Static"  INITCOND  "PRESET"
  LOADCASE "EQX"  LOADPAT  "EQX"  SF  1
  LOADCASE "EQY"  TYPE  "Linear Static"  INITCOND  "PRESET"
  LOADCASE "EQY"  LOADPAT  "EQY"  SF  1

$ LOAD COMBINATIONS
  COMBO "U1"  TYPE "Linear Add"
  COMBO "U1"  LOAD "Dead"  SF 1.4
  COMBO "U1"  LOAD "SDL"  SF 1.4
  COMBO "U2"  TYPE "Linear Add"
  COMBO "U2"  LOAD "Dead"  SF 1.2
  COMBO "U2"  LOAD "SDL"  SF 1.2
  COMBO "U2"  LOAD "Live"  SF 1.6
  COMBO "U2"  LOAD "RLive"  SF 0.5
  COMBO "U3"  TYPE "Linear Add"
  COMBO "U3"  LOAD "Dead"  SF 1.2
  COMBO "U3"  LOAD "SDL"  SF 1.2
  COMBO "U3"  LOAD "Live"  SF 1
  COMBO "U3"  LOAD "EQX"  SF -1
  COMBO "U4"  TYPE "Linear Add"
  COMBO "U4"  LOAD "U1"  SF 1
  COMBO "ENV"  TYPE "Envelope"
  COMBO "ENV"  LOAD "U1"  SF 1
  COMBO "ENV"  LOAD "U2"  SF 1

$ END OF MODEL FILE
