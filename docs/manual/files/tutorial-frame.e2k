$ File tutorial-frame.e2k: a synthetic 3-storey RC frame written by hand for the SAEngine manual (tutorial 4).
$ It is not an export of a real project. Units kN and m.

$ PROGRAM INFORMATION
  PROGRAM  "ETABS"  VERSION "21.0.0"

$ CONTROLS
  UNITS  "KN"  "M"  "C"
  TITLE2  "Tutorial Frame"

$ STORIES - IN SEQUENCE FROM TOP
  STORY "Story3"  HEIGHT 3.2
  STORY "Story2"  HEIGHT 3.2
  STORY "Story1"  HEIGHT 3.2
  STORY "Base"  ELEV 0

$ GRIDS
  GRIDSYSTEM "G1"  TYPE "CARTESIAN"
  GRID "G1"  LABEL "A"  DIR "X"  COORD 0
  GRID "G1"  LABEL "B"  DIR "X"  COORD 6
  GRID "G1"  LABEL "C"  DIR "X"  COORD 12
  GRID "G1"  LABEL "1"  DIR "Y"  COORD 0
  GRID "G1"  LABEL "2"  DIR "Y"  COORD 5
  GRID "G1"  LABEL "3"  DIR "Y"  COORD 10

$ MATERIAL PROPERTIES
  MATERIAL  "C28"  TYPE "Concrete"  WEIGHTPERVOLUME 23.5631
  MATERIAL  "C28"  SYMTYPE "Isotropic"  E 24870000  U 0.2  A 0.0000099
  MATERIAL  "C28"  FC 28000
  MATERIAL  "B420"  TYPE "Rebar"  WEIGHTPERVOLUME 76.9729
  MATERIAL  "B420"  SYMTYPE "Uniaxial"  E 200000000  A 0.0000117
  MATERIAL  "B420"  FY 420000  FU 525000

$ FRAME SECTIONS
  FRAMESECTION  "C400x400"  MATERIAL "C28"  SHAPE "Concrete Rectangular"  D 0.4  B 0.4
  FRAMESECTION  "B300x500"  MATERIAL "C28"  SHAPE "Concrete Rectangular"  D 0.5  B 0.3

$ CONCRETE SECTIONS
  CONCRETESECTION "C400x400"  LONGBARMATERIAL "B420"  CONFINEBARMATERIAL "B420"  TYPE "Column"  PATTERN "Rectangle"  CONFINEMENT "Ties"  COVER 0.04  NUMBARS3DIR 3  NUMBARS2DIR 3  BARSIZE "16d"  TIESIZE "10d"  TIESPACING 0.15  NUMR3BARS 2  NUMR2BARS 2  DESIGNTYPE "Check"
  CONCRETESECTION "B300x500"  LONGBARMATERIAL "B420"  CONFINEBARMATERIAL "B420"  TYPE "Beam"  COVERTOP 0.05  COVERBOTTOM 0.05

$ SHELL PROPERTIES
  SHELLPROP  "S150"  PROPTYPE  "Slab"  MATERIAL "C28"  MODELINGTYPE "ShellThin"  SLABTYPE "Slab"  SLABTHICKNESS 0.15

$ POINT COORDINATES
